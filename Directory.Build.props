<Project>
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <BuildInParallel>false</BuildInParallel>

    <!-- NuGet metadata shared across all packable projects -->
    <Authors>Soligent</Authors>
    <Company>Soligent</Company>
    <Copyright>Copyright © 2026 Soligent</Copyright>
    <PackageVersion>0.1.0-preview</PackageVersion>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/doelrgarcia/AISharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/doelrgarcia/AISharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>aisharp;ai;language;compiler;safety;policy</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
</Project>
