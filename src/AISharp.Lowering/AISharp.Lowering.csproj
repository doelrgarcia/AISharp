<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>AISharp.Lowering</PackageId>
    <Description>AI# lowering backend: lowers typed MIR to C# via Roslyn, emits source-map and debug-map artifacts.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AISharp.Compiler\AISharp.Compiler.csproj" />
  </ItemGroup>
</Project>
