// Shared System.Decimal core used by host constant folding and emitted C.
// 96-bit unsigned significand in w0..w2 (little-endian 32-bit words), flags = scale(16..23)|sign(31).
AI_DECIMAL_CODE(
typedef struct ai_decimal { uint32_t w0,w1,w2,flags; } ai_decimal;
typedef struct ai_dec_digits { uint32_t d[64]; int n; } ai_dec_digits;
static int ai_dec_scale(ai_decimal v){return (int)((v.flags>>16)&0x1f);}
static int ai_dec_negative(ai_decimal v){return (int)(v.flags>>31);}
static int ai_dec_is_zero(ai_decimal v){return (v.w0|v.w1|v.w2)==0;}
static ai_decimal ai_dec_make(uint32_t a,uint32_t b,uint32_t c,uint32_t f){ai_decimal v;v.w0=a;v.w1=b;v.w2=c;v.flags=f;return v;}
static void ai_dec_strip(ai_dec_digits* v){while(v->n>0 && v->d[v->n-1]==0)--v->n;}
static void ai_dec_copy(uint32_t* o,const uint32_t* i,int n){int k;for(k=0;k<n;++k)o[k]=i[k];}
static int ai_dec_add_small(ai_dec_digits* v,uint32_t digit){uint64_t carry=digit;int i;for(i=0;i<v->n;++i){uint64_t cur=v->d[i]+carry;v->d[i]=(uint32_t)(cur%10u);carry=cur/10u;if(!carry)return 0;}if(carry){if(v->n>=64)return 1;v->d[v->n++]=(uint32_t)carry;}return 0;}
static int ai_dec_mul10(ai_dec_digits* v){int i;if(v->n==0)return 0;if(v->n>=64)return 1;for(i=v->n;i>0;--i)v->d[i]=v->d[i-1];v->d[0]=0;++v->n;return 0;}
static uint32_t ai_dec_div10(ai_dec_digits* v){uint64_t rem=0;int i;for(i=v->n-1;i>=0;--i){uint64_t cur=rem*10u+v->d[i];v->d[i]=(uint32_t)(cur/10u);rem=cur%10u;}ai_dec_strip(v);return (uint32_t)rem;}
static int ai_dec_cmp_digits(const ai_dec_digits* a,const ai_dec_digits* b){int i;if(a->n!=b->n)return a->n<b->n?-1:1;for(i=a->n-1;i>=0;--i)if(a->d[i]!=b->d[i])return a->d[i]<b->d[i]?-1:1;return 0;}
static int ai_dec_add_digits(const ai_dec_digits* a,const ai_dec_digits* b,ai_dec_digits* o){int i,n=a->n>b->n?a->n:b->n;uint32_t carry=0;for(i=0;i<n;++i){uint32_t cur=carry+(i<a->n?a->d[i]:0u)+(i<b->n?b->d[i]:0u);o->d[i]=cur%10u;carry=cur/10u;}o->n=n;while(carry){if(o->n>=64)return 1;o->d[o->n++]=carry%10u;carry/=10u;}ai_dec_strip(o);return 0;}
static int ai_dec_sub_digits(const ai_dec_digits* a,const ai_dec_digits* b,ai_dec_digits* o){int i;int64_t borrow=0;ai_dec_digits r;for(i=0;i<a->n;++i){int64_t cur=(int64_t)a->d[i]-borrow-(i<b->n?b->d[i]:0);if(cur<0){cur+=10;borrow=1;}else borrow=0;r.d[i]=(uint32_t)cur;}if(borrow)return 1;r.n=a->n;ai_dec_strip(&r);*o=r;return 0;}
static int ai_dec_mul_digits(const ai_dec_digits* a,const ai_dec_digits* b,ai_dec_digits* o){uint32_t t[128]={0};int i,j,n,k;if(a->n==0||b->n==0){o->n=0;return 0;}if(a->n+b->n>128)return 1;for(i=0;i<a->n;++i){uint32_t carry=0;for(j=0;j<b->n;++j){uint32_t cur=t[i+j]+(uint32_t)a->d[i]*b->d[j]+carry;t[i+j]=cur%10u;carry=cur/10u;}k=i+b->n;while(carry){uint32_t cur=t[k]+carry;t[k]=cur%10u;carry=cur/10u;++k;}}n=a->n+b->n;while(n>0&&t[n-1]==0)--n;ai_dec_copy(o->d,t,n);o->n=n;return 0;}
static int ai_dec_mul_digit(const ai_dec_digits* a,uint32_t digit,ai_dec_digits* o){uint32_t carry=0;int i;for(i=0;i<a->n;++i){uint32_t cur=a->d[i]*digit+carry;o->d[i]=cur%10u;carry=cur/10u;}o->n=a->n;while(carry){if(o->n>=64)return 1;o->d[o->n++]=carry%10u;carry/=10u;}ai_dec_strip(o);return 0;}
static int ai_dec_from_digits(const ai_dec_digits* d,int scale,int sign,ai_decimal* o){uint32_t w[3]={0};int i;if(scale<0||scale>28)return 1;for(i=d->n-1;i>=0;--i){uint64_t carry=d->d[i];int j;for(j=0;j<3;++j){uint64_t cur=(uint64_t)w[j]*10u+carry;w[j]=(uint32_t)cur;carry=cur>>32;}if(carry)return 1;}o->w0=w[0];o->w1=w[1];o->w2=w[2];o->flags=((uint32_t)(scale&0x1f)<<16)|(sign?0x80000000u:0u);return 0;}
static int ai_dec_to_digits(ai_decimal v,ai_dec_digits* o){uint32_t w[3];o->n=0;w[0]=v.w0;w[1]=v.w1;w[2]=v.w2;while(w[0]|w[1]|w[2]){uint64_t rem=0;int i;for(i=2;i>=0;--i){uint64_t cur=rem*0x100000000ULL+w[i];w[i]=(uint32_t)(cur/10u);rem=cur%10u;}if(o->n>=64)return 1;o->d[o->n++]=(uint32_t)rem;}return 0;}
static void ai_dec_round_up(ai_dec_digits* d){int i;for(i=0;i<d->n;++i){if(++d->d[i]>9u)d->d[i]=0;else return;}if(d->n<64)d->d[d->n++]=1;}
static void ai_dec_round_last(ai_dec_digits* d,uint32_t rem){if(rem>5u||(rem==5u&&d->n>0&&(d->d[0]&1u)))ai_dec_round_up(d);}
static int ai_dec_normalize(ai_dec_digits* d,int* scale,int sign,ai_decimal* o){for(;;){ai_decimal c;if(*scale>28){uint32_t rem;if(*scale<=0)return 1;rem=ai_dec_div10(d);ai_dec_round_last(d,rem);--*scale;continue;}if(ai_dec_from_digits(d,*scale,sign,&c)==0){*o=c;return 0;}if(*scale==0)return 1;{uint32_t rem=ai_dec_div10(d);ai_dec_round_last(d,rem);}--*scale;}}
static int ai_dec_divmod_digits(const ai_dec_digits* num,const ai_dec_digits* den,ai_dec_digits* q,ai_dec_digits* r){ai_dec_digits rem;int i;q->n=0;r->n=0;rem.n=0;if(den->n==0)return 2;for(i=num->n-1;i>=0;--i){uint32_t digit=0;if(ai_dec_mul10(&rem))return 1;if(ai_dec_add_small(&rem,num->d[i]))return 1;while(digit<9){ai_dec_digits next;if(ai_dec_mul_digit(den,digit+1,&next))return 1;if(ai_dec_cmp_digits(&next,&rem)>0)break;++digit;}if(digit){ai_dec_digits probe,diff;ai_dec_mul_digit(den,digit,&probe);if(ai_dec_sub_digits(&rem,&probe,&diff))return 1;rem=diff;}{int k;if(q->n>=64)return 1;for(k=q->n;k>0;--k)q->d[k]=q->d[k-1];q->d[0]=digit;++q->n;}}ai_dec_strip(q);r->n=rem.n;ai_dec_copy(r->d,rem.d,rem.n);return 0;}
static void ai_dec_align(ai_decimal v,int target,ai_dec_digits* o){int diff;ai_dec_to_digits(v,o);for(diff=target-ai_dec_scale(v);diff>0;--diff)ai_dec_mul10(o);}
static int ai_dec_cmp(ai_decimal a,ai_decimal b){int scale=ai_dec_scale(a)>ai_dec_scale(b)?ai_dec_scale(a):ai_dec_scale(b);ai_dec_digits da,db;int c;if(ai_dec_is_zero(a)&&ai_dec_is_zero(b))return 0;ai_dec_align(a,scale,&da);ai_dec_align(b,scale,&db);c=ai_dec_cmp_digits(&da,&db);if(ai_dec_negative(a)!=ai_dec_negative(b))return ai_dec_negative(a)?-1:1;return ai_dec_negative(a)?-c:c;}
static int ai_dec_core_add(ai_decimal a,ai_decimal b,ai_decimal* o){int scale=ai_dec_scale(a)>ai_dec_scale(b)?ai_dec_scale(a):ai_dec_scale(b);ai_dec_digits da,db,sum;int sign=ai_dec_negative(a);ai_dec_align(a,scale,&da);ai_dec_align(b,scale,&db);if(ai_dec_negative(a)==ai_dec_negative(b)){if(ai_dec_add_digits(&da,&db,&sum))return 1;}else{int c=ai_dec_cmp_digits(&da,&db);if(c==0){ai_dec_digits z;z.n=0;return ai_dec_from_digits(&z,0,0,o);}if(c>0){sign=ai_dec_negative(a);if(ai_dec_sub_digits(&da,&db,&sum))return 1;}else{sign=ai_dec_negative(b);if(ai_dec_sub_digits(&db,&da,&sum))return 1;}}return ai_dec_normalize(&sum,&scale,sign,o);}
static int ai_dec_core_sub(ai_decimal a,ai_decimal b,ai_decimal* o){b.flags^=0x80000000u;return ai_dec_core_add(a,b,o);}
static int ai_dec_core_mul(ai_decimal a,ai_decimal b,ai_decimal* o){ai_dec_digits da,db,p;int scale=ai_dec_scale(a)+ai_dec_scale(b);int sign=ai_dec_negative(a)^ai_dec_negative(b);ai_dec_to_digits(a,&da);ai_dec_to_digits(b,&db);if(ai_dec_mul_digits(&da,&db,&p))return 1;return ai_dec_normalize(&p,&scale,sign,o);}
static int ai_dec_core_div(ai_decimal a,ai_decimal b,ai_decimal* o){ai_dec_digits num,den,q,rem;int scale,exp,sign=ai_dec_negative(a)^ai_dec_negative(b);int i;if(ai_dec_is_zero(b))return 2;if(ai_dec_is_zero(a)){ai_dec_digits z;z.n=0;return ai_dec_from_digits(&z,0,0,o);}scale=ai_dec_scale(a)>ai_dec_scale(b)?ai_dec_scale(a)-ai_dec_scale(b):0;exp=scale+ai_dec_scale(b)-ai_dec_scale(a);ai_dec_to_digits(a,&num);ai_dec_to_digits(b,&den);for(i=0;i<exp;++i)if(ai_dec_mul10(&num))return 1;if(ai_dec_divmod_digits(&num,&den,&q,&rem))return 1;while(rem.n!=0&&scale<28){uint32_t digit=0;ai_dec_digits probe,diff;if(ai_dec_mul10(&rem))return 1;while(digit<9){ai_dec_digits next;if(ai_dec_mul_digit(&den,digit+1,&next))return 1;if(ai_dec_cmp_digits(&next,&rem)>0)break;++digit;}if(digit){ai_dec_mul_digit(&den,digit,&probe);if(ai_dec_sub_digits(&rem,&probe,&diff))return 1;rem=diff;}{int k;if(q.n>=64)return 1;for(k=q.n;k>0;--k)q.d[k]=q.d[k-1];q.d[0]=digit;++q.n;}++scale;}if(rem.n!=0){uint32_t digit=0;if(ai_dec_mul10(&rem))return 1;while(digit<9){ai_dec_digits next;if(ai_dec_mul_digit(&den,digit+1,&next))return 1;if(ai_dec_cmp_digits(&next,&rem)>0)break;++digit;}if(digit>5u||(digit==5u&&q.n>0&&(q.d[0]&1u)))ai_dec_round_up(&q);}ai_dec_strip(&q);{int result_scale=scale;return ai_dec_normalize(&q,&result_scale,sign,o);}}
static int ai_dec_core_neg(ai_decimal a,ai_decimal* o){*o=a;o->flags^=0x80000000u;return 0;}
static int ai_dec_to_u64(ai_decimal v,uint64_t* out,int* overflow){ai_dec_digits d;int scale=ai_dec_scale(v);int i;uint64_t result=0;ai_dec_to_digits(v,&d);if(scale>=d.n){*out=0;*overflow=0;return 0;}for(i=d.n-1;i>=scale;--i){if(result>(UINT64_MAX-d.d[i])/10u){*overflow=1;return 0;}result=result*10u+d.d[i];}*out=result;*overflow=0;return 0;}
static int ai_dec_core_from_i64(int64_t value,ai_decimal* o){uint64_t magnitude=value<0?(uint64_t)(-(value+1))+1u:(uint64_t)value;ai_dec_digits d;d.n=0;while(magnitude){d.d[d.n++]=(uint32_t)(magnitude%10u);magnitude/=10u;}return ai_dec_from_digits(&d,0,value<0,o);}
static int ai_dec_core_from_u64(uint64_t value,ai_decimal* o){ai_dec_digits d;d.n=0;while(value){d.d[d.n++]=(uint32_t)(value%10u);value/=10u;}return ai_dec_from_digits(&d,0,0,o);}
static int ai_dec_to_double_value(ai_decimal v,double* out){static const double powers[29]={1e0,1e1,1e2,1e3,1e4,1e5,1e6,1e7,1e8,1e9,1e10,1e11,1e12,1e13,1e14,1e15,1e16,1e17,1e18,1e19,1e20,1e21,1e22,1e23,1e24,1e25,1e26,1e27,1e28};ai_dec_digits d;int i;double result=0.0;int scale=ai_dec_scale(v);ai_dec_to_digits(v,&d);for(i=d.n-1;i>=0;--i)result=result*10.0+(double)d.d[i];if(scale>0)result/=powers[scale];if(ai_dec_negative(v))result=-result;*out=result;return 0;}
static int ai_dec_core_from_text(const char* text,ai_decimal* o){const char* p=text;int sign=0,scale=0,exponent=0,exponent_sign=1;ai_dec_digits d;d.n=0;if(*p=='-'){sign=1;++p;}else if(*p=='+')++p;while(*p>='0'&&*p<='9'){if(d.n>=64)return 1;memmove(d.d+1,d.d,sizeof(uint32_t)*(size_t)d.n);d.d[0]=(uint32_t)(*p-'0');++d.n;ai_dec_strip(&d);++p;}if(*p=='.'){++p;while(*p>='0'&&*p<='9'){if(d.n>=64)return 1;memmove(d.d+1,d.d,sizeof(uint32_t)*(size_t)d.n);d.d[0]=(uint32_t)(*p-'0');++d.n;ai_dec_strip(&d);++scale;++p;}}if(*p=='e'||*p=='E'){++p;if(*p=='-'){exponent_sign=-1;++p;}else if(*p=='+')++p;while(*p>='0'&&*p<='9'){exponent=exponent*10+(*p-'0');++p;}}exponent*=exponent_sign;scale-=exponent;if(d.n==0){scale=scale<0?0:scale>28?28:scale;return ai_dec_from_digits(&d,scale,sign,o);}if(scale<0){int i;for(i=0;i<-scale;++i)if(ai_dec_mul10(&d))return 1;scale=0;}return ai_dec_normalize(&d,&scale,sign,o);}
static int ai_dec_core_from_double(double value,ai_decimal* o){char buffer[40];double magnitude;if(!(value==value))return 1;magnitude=value<0?-value:value;if(magnitude>1.0e300)return 1;{int length=snprintf(buffer,sizeof(buffer),"%.15g",value);if(length<=0||length>=(int)sizeof(buffer))return 1;}return ai_dec_core_from_text(buffer,o);}
static int ai_dec_core_from_float(float value,ai_decimal* o){char buffer[40];float magnitude;if(!(value==value))return 1;magnitude=value<0?-value:value;if(magnitude>3.4e38f)return 1;{int length=snprintf(buffer,sizeof(buffer),"%.7g",value);if(length<=0||length>=(int)sizeof(buffer))return 1;}return ai_dec_core_from_text(buffer,o);}
