void ir_type_expression(std::ostream& out,const NativeTypeExpression& e,std::size_t depth=0){
    if(depth>128)fail("AI3100","Generic inspection depth limit exceeded.",e.at);out<<"{\"kind\":\""<<(e.kind==NativeTypeExpression::concrete ? "concrete" : e.kind==NativeTypeExpression::parameter ? "parameter" : "application")<<"\",\"identity\":"<<e.identity<<",\"primitive\":"<<e.shape.primitive<<",\"nominalType\":"<<e.shape.product<<",\"borrowModes\":";ir_ids(out,e.shape.references);out<<",\"location\":";ir_location(out,e.at);out<<",\"arguments\":[";for(std::size_t i=0;i<e.arguments.size();++i){if(i)out<<',';ir_type_expression(out,e.arguments[i],depth+1);}out<<"]}";if(out.tellp()>64*1024*1024)fail("AI3100","Generic inspection output limit exceeded.",e.at);
}
void ir_case_payload(std::ostream& out,const NativeUnionCase& c,const std::shared_ptr<const NativeProductTable>& table){
    out<<",\"payload\":[";for(std::size_t i=0;i<c.payload.size();++i){if(i)out<<',';out<<"{\"index\":"<<i<<",\"field\":"<<c.fields[i]<<",\"type\":\""<<Type::from_shape(table,c.payload[i].type).label()<<"\",\"location\":";ir_location(out,c.payload[i].at);out<<'}';}out<<']';
}
void ir_generic_types(std::ostream& out,const std::shared_ptr<const NativeProductTable>& table){
    out<<'[';if(table)for(std::size_t id=0;id<table->generics.size();++id){if(id)out<<',';auto& g=table->generics[id];out<<"{\"id\":"<<id<<",\"name\":\""<<g.name<<"\",\"kind\":\""<<(g.union_ ? "union" : "product")<<"\",\"location\":";ir_location(out,g.at);out<<",\"parameters\":[";for(std::size_t i=0;i<g.parameters.size();++i){if(i)out<<',';out<<"{\"index\":"<<i<<",\"name\":\""<<g.parameters[i].name<<"\",\"location\":";ir_location(out,g.parameters[i].at);out<<'}';}out<<"],\"fields\":[";for(std::size_t i=0;i<g.fields.size();++i){if(i)out<<',';out<<"{\"index\":"<<i<<",\"name\":\""<<g.fields[i].name<<"\",\"typeExpression\":";ir_type_expression(out,g.fields[i].type);out<<",\"location\":";ir_location(out,g.fields[i].at);out<<'}';}out<<"],\"cases\":[";for(std::size_t i=0;i<g.cases.size();++i){if(i)out<<',';out<<"{\"index\":"<<i<<",\"name\":\""<<g.cases[i].name<<"\",\"location\":";ir_location(out,g.cases[i].at);out<<",\"payload\":[";for(std::size_t k=0;k<g.cases[i].payload.size();++k){if(k)out<<',';out<<"{\"index\":"<<k<<",\"typeExpression\":";ir_type_expression(out,g.cases[i].payload[k].type);out<<",\"location\":";ir_location(out,g.cases[i].payload[k].at);out<<'}';}out<<"]}";}out<<"]}";}out<<']';
}
void ir_type_arguments(std::ostream& out,const std::shared_ptr<const NativeProductTable>& table,const NativeProductDefinition& d){
    out<<'[';for(std::size_t i=0;i<d.arguments.size();++i){if(i)out<<',';auto& a=d.arguments[i];out<<"{\"type\":\""<<Type::from_shape(table,a).label()<<"\",\"primitive\":"<<a.primitive<<",\"nominalType\":"<<a.product<<",\"borrowModes\":";ir_ids(out,a.references);out<<",\"location\":";ir_location(out,d.argument_locations[i]);out<<'}';}out<<']';if(d.generic>=0){out<<",\"instantiationLocation\":";ir_location(out,d.instantiation_at);}
}
