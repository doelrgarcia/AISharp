    else{
        if(e.shape.primitive!=2 || e.shape.product!=-1)fail("AI3100","Generic variable/application carries a concrete identity.",e.at);
        if(e.kind==NativeTypeExpression::parameter){if(e.identity<0 || static_cast<std::size_t>(e.identity)>=parameters || !e.arguments.empty())fail("AI3100","Unbound native generic type parameter.",e.at);}
        else if(e.kind==NativeTypeExpression::application){if(e.identity<0 || static_cast<std::size_t>(e.identity)>=table.generics.size() || e.arguments.size()!=table.generics[static_cast<std::size_t>(e.identity)].parameters.size())fail("AI3107","Generic type argument count differs from its parameters.",e.at);for(auto& a:e.arguments)native_validate_expression(a,parameters,table,work,depth+1);}
        else fail("AI3100","Invalid native generic type expression kind.",e.at);
    }
}
void native_validate_generic(const NativeGenericDefinition& g,const NativeProductTable& table,std::size_t& work){
