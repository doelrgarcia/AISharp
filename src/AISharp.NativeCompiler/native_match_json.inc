void ir_matches(std::ostream& out,const IrFunction& f){
    out<<'[';bool comma=false;for(auto& m:f.matches){if(comma)out<<',';comma=true;out<<"{\"scrutinee\":"<<m.scrutinee<<",\"subjectPlace\":"<<m.subject<<",\"resultType\":\""<<m.type.label()<<"\",\"entryBlock\":"<<m.entry<<",\"mergeBlock\":"<<m.merge<<",\"resultPlace\":"<<m.place<<",\"resultValue\":"<<m.result<<",\"unmatchedFaultBlock\":"<<m.fault<<",\"dispatchEndBlock\":"<<m.dispatch_end<<",\"location\":";ir_location(out,m.at);
        if(m.propagation)out<<",\"explicitPropagation\":true";
        out<<",\"sourceArms\":[";bool sc=false;for(auto& a:m.sources){if(sc)out<<',';sc=true;out<<"{\"patternValue\":"<<a.pattern<<",\"guardMode\":"<<a.guard_mode<<",\"location\":";ir_location(out,a.at);if(a.guard_mode!=-2){out<<",\"guardLocation\":";ir_location(out,a.guard_at);}out<<",\"valueLocation\":";ir_location(out,a.value_at);out<<'}';}out<<"],\"dispatch\":[";bool dc=false;for(auto& d:m.dispatch){if(dc)out<<',';dc=true;out<<"{\"block\":"<<d.block<<",\"selector\":"<<d.selector<<",\"condition\":"<<d.condition<<",\"group\":"<<d.group<<",\"nextBlock\":"<<d.next<<'}';}out<<"],\"groups\":[";
        bool gc=false;for(auto& g:m.groups){if(gc)out<<',';gc=true;out<<"{\"entryBlock\":"<<g.entry<<",\"tailBlock\":"<<g.tail<<",\"otherIntegerValues\":"<<(g.other ? "true" : "false")<<",\"selectors\":";ir_ids(out,g.selectors);out<<",\"arms\":[";bool ac=false;for(auto& a:g.arms){if(ac)out<<',';ac=true;out<<"{\"sourceArm\":"<<a.source<<",\"testBlock\":"<<a.test<<",\"guardEntryBlock\":"<<a.guard_entry<<",\"guardEndBlock\":"<<a.guard_end<<",\"guardValue\":"<<a.guard<<",\"bodyBlock\":"<<a.body<<",\"valueBlock\":"<<a.value_block<<",\"value\":"<<a.value<<",\"nextBlock\":"<<a.next<<'}';}out<<"]}";}out<<"]}";if(out.tellp()>64*1024*1024)fail("AI3100","Native match proof output limit exceeded.",m.at);
    }out<<']';
}
