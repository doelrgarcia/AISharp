                if(match.place>=0 && !propagating){int count=0;for(auto& o:block(arm.value_block).ops){charge(1);if(o.kind=="write" && o.place==match.place){if(o.operands!=std::vector<int>{arm.value})bad(o.at);++count;}}if(count!=1)bad(arm.value_at);}
