// Independent may-presence and case feasibility proof. Empty inactive components
// never stand in for active references whose input lifetime is unknown.
template<class Charge> NativeVariantTags native_variant_tags(Type type,Charge& charge){
    NativeVariantTags result;std::vector<std::pair<Type,ComponentPath>> pending={{type,{}}};
    while(!pending.empty()){auto [next,path]=std::move(pending.back());pending.pop_back();charge(1+path.size());if(next.is_union())for(std::size_t c=0;c<next.definition().cases.size();++c){charge(1);result[path].insert(static_cast<int>(c));}if(next.is_aggregate())for(std::size_t i=0;i<next.definition().fields.size();++i){auto nested=path;nested.push_back(static_cast<int>(i));pending.emplace_back(next.field_type(i),std::move(nested));}}return result;
}
struct NativePayloadPresence {std::map<int,std::set<ComponentPath>> values;std::set<ComponentPath> returned;NativeVariantTags returned_tags;std::map<int,std::set<int>> possible_cells;std::set<int> feasible;std::set<std::pair<int,int>> edges;};
