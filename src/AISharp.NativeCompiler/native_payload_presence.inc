    using Paths=std::set<ComponentPath>;using Cases=std::set<int>;NativePayloadPresence proof;auto all_places=f.places;all_places.insert(all_places.end(),f.external_places.begin(),f.external_places.end());IrPlaceGraph graph(all_places);
    struct State{std::set<int> references;std::map<int,Cases> tags;std::map<int,Cases> pointers;bool operator==(const State&)const=default;};
    auto paths=[](const Type& type){Paths result;if(type.is_reference())result.insert(ComponentPath{});else if(type.is_aggregate())result.insert(type.definition().reference_paths.begin(),type.definition().reference_paths.end());return result;};
    auto project=[&](int root,const ComponentPath& path){for(int field:path){charge(1);root=graph.child(root,field);}return root;};
    auto erase=[&](State& state,int root){auto nested=graph.subtree(root);charge(nested.size());for(int id:nested){state.references.erase(id);state.tags.erase(id);state.pointers.erase(id);}};
    auto add=[&](auto& into,const auto& from){bool changed=false;for(auto& item:from){charge(1);changed=into.insert(item).second || changed;}return changed;};
    auto tags_add=[&](NativeVariantTags& into,const NativeVariantTags& from){bool changed=false;for(auto& [path,cases]:from){charge(1+path.size());changed=add(into[path],cases) || changed;}return changed;};
    std::map<int,NativeVariantTags> value_tags;std::map<int,NativeVariantTags> value_pointers;std::map<int,Cases> scalar_tags;std::map<int,const IrOp*> ops;for(auto& b:f.blocks)for(auto& o:b.ops)ops.emplace(o.id,&o);
    auto mutates=[&](const IrFunction& target){for(auto& [destination,origins]:target.summary.effects){charge(1+origins.size());auto cell=target.external_ids.at(destination);auto input=std::find_if(target.inputs.begin(),target.inputs.end(),[&](auto& edge){charge(1);return edge.cell==cell;});if(input==target.inputs.end())fail("AI3100","Payload effect lacks its input edge.",target.declaration);if(origins!=RegionSet{target.external_paths.at(input->storage)})return true;}return false;};
    auto conditional_cell=[&](int id){for(int parent:graph.parents(id)){charge(1);if(graph.at(parent).type.is_payload_union())return true;}return false;};
    auto origin_targets=[&](const RegionPath& source,const IrOp& call,const State& state){
        if(source.first<0 || static_cast<std::size_t>(source.first)>=call.operands.size())fail("AI3100","Payload return origin has an invalid parameter.",call.at);int argument=call.operands[static_cast<std::size_t>(source.first)];ComponentPath prefix;std::size_t step=0;while(step<source.selectors.size() && source.selectors[step]>=0)prefix.push_back(source.selectors[step++]);if(step==source.selectors.size())return Cases{-1};if(!proof.values[argument].contains(prefix))return Cases{};Cases result=value_pointers[argument][prefix];if(result.empty())result.insert(-1);
