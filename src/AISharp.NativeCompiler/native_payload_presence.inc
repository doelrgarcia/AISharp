    std::vector<State> output(f.blocks.size());std::vector<std::vector<int>> predecessors(f.blocks.size());for(auto& b:f.blocks)if(b.reachable)for(int next:b.successors)predecessors[static_cast<std::size_t>(next)].push_back(b.id);
    proof.feasible.insert(0);bool changed=true;while(changed){changed=false;for(auto& b:f.blocks)if(b.reachable && proof.feasible.contains(b.id)){State state;if(b.id==0)state=initial;for(int parent:predecessors[static_cast<std::size_t>(b.id)])if(proof.edges.contains({parent,b.id})){auto& incoming=output[static_cast<std::size_t>(parent)];add(state.references,incoming.references);for(auto& [id,cases]:incoming.tags)add(state.tags[id],cases);for(auto& [id,targets]:incoming.pointers)add(state.pointers[id],targets);}
        for(auto& o:b.ops){charge(1);Paths value;NativeVariantTags tags,pointers;
            if(o.kind=="parameter"){for(auto& path:paths(graph.at(o.place).type)){auto cell=project(o.place,path);state.references.insert(cell);Cases targets;for(auto& input:f.inputs){charge(1);if(input.cell==cell)targets.insert(input.storage);}if(targets.empty())targets.insert(-1);state.pointers[cell]=std::move(targets);}for(auto& [path,cases]:native_variant_tags(graph.at(o.place).type,charge))state.tags[project(o.place,path)]=cases;}
            else if(o.kind=="write")store(state,o.place,o.operands[0],true);
            else if(o.kind=="storage-live" || o.kind=="storage-dead")erase(state,o.place);
            else if(o.kind=="variant-tag"){auto type=graph.at(o.place).type;Cases cases;if(type.is_reference()){for(int target:state.pointers[o.place]){charge(1);if(target==-1 || !graph.contains(target)){for(std::size_t c=0;c<type.pointee().definition().cases.size();++c)cases.insert(static_cast<int>(c));}else add(cases,state.tags[target]);}}else cases=state.tags[o.place];changed=add(scalar_tags[o.id],cases) || changed;}
            else if(o.kind=="copy-read" || o.kind=="move" || o.kind=="reference-use"){for(auto& path:paths(o.type))if(state.references.contains(project(o.place,path))){value.insert(path);pointers[path]=state.pointers[project(o.place,path)];if(pointers[path].empty())pointers[path].insert(-1);}for(auto& [path,ignored]:native_variant_tags(o.type,charge)){(void)ignored;auto found=state.tags.find(project(o.place,path));if(found!=state.tags.end())tags[path]=found->second;}if(o.kind=="move")erase(state,o.place);}
            else if(o.kind=="aggregate-pack" || o.kind=="variant-pack"){
                if(o.kind=="variant-pack")tags[{}].insert(o.field);
                for(std::size_t i=0;i<o.operands.size();++i){int field=o.kind=="variant-pack" ? o.type.definition().cases[static_cast<std::size_t>(o.field)].fields[i] : static_cast<int>(i);if(field<0)continue;for(auto path:proof.values[o.operands[i]]){charge(1+path.size());path.insert(path.begin(),field);value.insert(std::move(path));}for(auto& [path,cases]:value_tags[o.operands[i]]){auto nested=path;nested.insert(nested.begin(),field);add(tags[nested],cases);}for(auto& [path,targets]:value_pointers[o.operands[i]]){auto nested=path;nested.insert(nested.begin(),field);add(pointers[nested],targets);}}
            }else if(o.kind=="aggregate-extract"){
                for(auto path:proof.values[o.operands[0]])if(!path.empty() && path.front()==o.field){path.erase(path.begin());value.insert(std::move(path));}for(auto& [path,cases]:value_tags[o.operands[0]])if(!path.empty() && path.front()==o.field)tags[ComponentPath(path.begin()+1,path.end())]=cases;for(auto& [path,targets]:value_pointers[o.operands[0]])if(!path.empty() && path.front()==o.field)pointers[ComponentPath(path.begin()+1,path.end())]=targets;
            }else if(o.kind=="call" && o.function>=0){
                auto& target=*signatures.at(o.function);value=target.summary.possible_components;tags=target.summary.possible_tags;
                // A returned component cannot be active when every permitted
                // input origin is in an absent alternative of the actual argument.
