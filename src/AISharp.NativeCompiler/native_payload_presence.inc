    State initial;for(auto& place:f.external_places){charge(1);if(place.type.is_reference())initial.references.insert(place.id);if(place.type.is_union())for(std::size_t c=0;c<place.type.definition().cases.size();++c)initial.tags[place.id].insert(static_cast<int>(c));}for(auto& input:f.inputs)if(input.cell<0)initial.pointers[input.cell].insert(input.storage);
    auto store=[&](State& state,int root,int operand,bool strong){strong=strong && !f.summary_places.contains(root);if(strong)erase(state,root);for(auto& path:proof.values[operand]){int cell=project(root,path);state.references.insert(cell);auto targets=value_pointers[operand][path];if(targets.empty())targets.insert(-1);if(strong)state.pointers[cell]=std::move(targets);else add(state.pointers[cell],targets);}for(auto& [path,cases]:value_tags[operand]){int cell=project(root,path);if(strong)state.tags[cell]=cases;else add(state.tags[cell],cases);}};
