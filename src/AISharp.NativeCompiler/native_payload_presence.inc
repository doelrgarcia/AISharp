        if(state!=output[static_cast<std::size_t>(b.id)]){output[static_cast<std::size_t>(b.id)]=std::move(state);changed=true;}
        std::set<int> feasible_next(b.successors.begin(),b.successors.end());if(b.end=="branch" && b.successors.size()==2){auto condition=ops.at(b.condition);if(condition->kind=="binary:=="){auto left=ops.at(condition->operands[0]),right=ops.at(condition->operands[1]);if(left->kind=="variant-tag" && right->kind=="constant"){auto& cases=scalar_tags[left->id];feasible_next.clear();if(cases.contains(static_cast<int>(right->literal)))feasible_next.insert(b.successors[0]);if(std::any_of(cases.begin(),cases.end(),[&](int c){return c!=right->literal;}))feasible_next.insert(b.successors[1]);}}}
