                else for(auto& place:all_places){charge(1);if(place.type.is_union()){state.tags[place.id].clear();for(std::size_t c=0;c<place.type.definition().cases.size();++c)state.tags[place.id].insert(static_cast<int>(c));}if(place.type.is_reference()){state.references.insert(place.id);state.pointers[place.id]={-1};}}
