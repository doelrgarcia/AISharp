            else if(o.kind=="borrow-shared" || o.kind=="borrow-exclusive"){value.insert(ComponentPath{});pointers[{}].insert(o.place);}
            else if(o.kind.starts_with("reborrow-")){value.insert(ComponentPath{});pointers=value_pointers[o.operands[0]];}
            else if(o.kind=="variant-borrow" || o.kind=="reference-field"){value.insert(ComponentPath{});auto targets=o.kind=="variant-borrow" ? state.pointers[o.place] : value_pointers[o.operands[0]][{}];for(int target:targets){charge(1);pointers[{}].insert(target==-1 || !graph.contains(target) ? -1 : graph.child(target,o.field));}}
            else if(o.kind=="reference-read" || o.kind.starts_with("reference-follow-")){auto targets=value_pointers[o.operands[0]][{}];pointers=load_pointers(state,targets,o.type);for(auto& [path,items]:pointers)if(!items.empty())value.insert(path);for(auto& [path,all]:native_variant_tags(o.type,charge))for(int target:targets){charge(1);if(target==-1 || !graph.contains(target))add(tags[path],all);else add(tags[path],state.tags[project(target,path)]);}}
