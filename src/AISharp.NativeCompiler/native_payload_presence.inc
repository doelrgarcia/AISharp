                for(auto component=value.begin();component!=value.end();){Type next=o.type;ComponentPath prefix;bool active=true;for(int field:*component){charge(1);if(next.is_payload_union() && !tags[prefix].contains(next.field_case(static_cast<std::size_t>(field)))){active=false;break;}prefix.push_back(field);next=next.field_type(static_cast<std::size_t>(field));}if(active)++component;else component=value.erase(component);}
                for(auto& component:value){const RegionSet* sources=nullptr;if(component.empty() && o.type.is_reference())sources=&target.summary.returned;else {auto found=target.summary.returned_components.find(component);if(found!=target.summary.returned_components.end())sources=&found->second;}if(!sources || sources->empty())pointers[component].insert(-1);else for(auto& source:*sources)add(pointers[component],origin_targets(source,o,state));}
