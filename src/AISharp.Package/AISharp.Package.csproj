<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AISharp.Package</RootNamespace>
    <AssemblyName>AISharp.Package</AssemblyName>
    <PackageId>AISharp.Package</PackageId>
    <Description>AI# package manifest, lockfile, and project tooling support.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
