fn emit_generic_instantiations(source:&owned buffer,tokens:&owned buffer,limit:int,out:&mut owned buffer,pos:&mut int,error:&mut int)->int
ensures true
{
 var reg=buffer(65536)
 var regpos=0
 var noparams=buffer(64)
 var noargs=buffer(64)
 var di=0
 while(*error==0 && di+2<limit)
 {
 var is_generic_decl=0
 if((is_type_kw(source,tokens,di) || tok_equals(source,tokens,di,"class")) && tok_kind(tokens,di+1)==1 && tok_kind(tokens,di+2)==4 && tok_value(tokens,di+2)==60){is_generic_decl=1}
