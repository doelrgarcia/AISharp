append_text(&mut *out,&mut *pos," tmp.data[qj]){\n    unsigned char tmpv=tmp.data[qi];\n    tmp.data[qi]=tmp.data[qj];\n    tmp.data[qj]=tmpv;\n    }\n    qj=qj+1;\n    }\n    qi=qi+1;\n    }\n    qi=0;\n    while(qi<ai_buffer_size(&")
