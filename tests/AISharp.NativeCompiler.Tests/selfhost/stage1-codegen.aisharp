 c=c+1
 while(c<bend && !(tok_kind(tokens,c)==4 && tok_value(tokens,c)==93))
 {
 append_token(&mut *out,&mut *pos,source,tokens,c)
 c=c+1
 }
 if(c<bend){c=c+1}
 append_text(&mut *out,&mut *pos,"]")
 }
 append_text(&mut *out,&mut *pos,"; ")
 if(c<bend && tok_kind(tokens,c)==4 && (tok_value(tokens,c)==44 || tok_value(tokens,c)==59)){c=c+1}
 }
 append_text(&mut *out,&mut *pos,"} ")
 append_span(&mut *out,&mut *pos,&key,keypos)
 append_text(&mut *out,&mut *pos,";\n")
 var key2=buffer(1024)
 var key2pos=0
 emit_inst_key(source,tokens,name_index,gargs,acount,limit,&mut key2,&mut key2pos)
 append_text(&mut *out,&mut *pos,"#define ")
 append_span(&mut *out,&mut *pos,&key2,key2pos)
