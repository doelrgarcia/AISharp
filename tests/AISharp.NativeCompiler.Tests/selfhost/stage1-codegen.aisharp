 if(tok_kind(tokens,c)!=1){*error=1
 return 0}
 c=c+1
 if(c>=limit || tok_kind(tokens,c)!=4 || tok_value(tokens,c)!=58){*error=1
 return 0}
 c=c+1
 let tstart=c
