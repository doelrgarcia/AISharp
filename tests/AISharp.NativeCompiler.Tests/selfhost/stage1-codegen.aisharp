while(j<limit && !(tok_kind(tokens,j)==4 && tok_value(tokens,j)==45)){j=j+1}
if(j+2<limit && tok_kind(tokens,j+1)==4 && tok_value(tokens,j+1)==62 && word(source,tokens,j+2,111,119,110,101,100,0,5)){return true}
}
i=i+1
}
return false
}
fn body_has_yield(source:&owned buffer,tokens:&owned buffer,start:int,limit:int)->bool
