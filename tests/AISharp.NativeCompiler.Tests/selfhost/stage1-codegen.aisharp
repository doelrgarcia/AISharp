 write32(&mut *reg,*regpos,keypos)
 var kc=0
 while(kc<keypos)
 {
 bufferWrite(reg,*regpos+4+kc,bufferPeek(&key,kc))
 kc=kc+1
 }
 *regpos=*regpos+4+keypos
 var gparams=buffer(256)
 var pcount=0
 collect_generic_params(source,tokens,name_index,limit,&mut gparams,&mut pcount)
 let body=generic_header_body(source,tokens,name_index,limit)
