fn emit_finally_control(source:&owned buffer,tokens:&owned buffer,tp:&mut int,limit:int,out:&mut owned buffer,pos:&mut int,error:&mut int,loop_depth:int)->bool
ensures true
{
let body_start=*tp
var depth=0
var i=body_start
while(i<limit)
{
if(tok_kind(tokens,i)==4 && tok_value(tokens,i)==123){depth=depth+1}
else
{
if(tok_kind(tokens,i)==4 && tok_value(tokens,i)==125)
{
if(depth==0){break}
depth=depth-1
}
}
i=i+1
}
let body_end=i
var j=body_end+1
if(j<limit && word(source,tokens,j,99,97,116,99,104,0,5))
{
j=j+1
if(j<limit && tok_kind(tokens,j)==4 && tok_value(tokens,j)==40)
{
j=j+1
if(j<limit && tok_kind(tokens,j)==1){j=j+1}
if(j<limit && tok_kind(tokens,j)==4 && tok_value(tokens,j)==41){j=j+1}
}
if(j<limit && tok_kind(tokens,j)==4 && tok_value(tokens,j)==123)
{
j=j+1
var d2=0
while(j<limit)
{
if(tok_kind(tokens,j)==4 && tok_value(tokens,j)==123){d2=d2+1}
else
{
if(tok_kind(tokens,j)==4 && tok_value(tokens,j)==125)
{
if(d2==0){j=j+1
break}
d2=d2-1
}
}
j=j+1
}
}
}
if(j>=limit || !word(source,tokens,j,102,105,110,97,108,108,7)){return false}
j=j+1
if(j>=limit || tok_kind(tokens,j)!=4 || tok_value(tokens,j)!=123){return false}
j=j+1
let fin_start=j
var d3=0
while(j<limit)
{
if(tok_kind(tokens,j)==4 && tok_value(tokens,j)==123){d3=d3+1}
else
{
if(tok_kind(tokens,j)==4 && tok_value(tokens,j)==125)
{
if(d3==0){break}
d3=d3-1
}
}
j=j+1
}
let fin_end=j
if(body_start>=body_end){return false}
if(word(source,tokens,body_start,114,101,116,117,114,110,6))
{
var fp=fin_start
emit_block_scope(source,tokens,&mut fp,limit,&mut *out,&mut *pos,&mut *error,loop_depth)
if(*error!=0){return false}
var bp=body_start+1
append_text(&mut *out,&mut *pos,"    return ")
emit_logical(source,tokens,&mut bp,limit,&mut *out,&mut *pos,&mut *error)
if(*error!=0){return false}
append_text(&mut *out,&mut *pos,";\n")
*tp=fin_end+1
return true
}
if(word(source,tokens,body_start,98,114,101,97,107,0,5))
{
var fp=fin_start
emit_block_scope(source,tokens,&mut fp,limit,&mut *out,&mut *pos,&mut *error,loop_depth)
if(*error!=0){return false}
append_text(&mut *out,&mut *pos,"    break;\n")
*tp=fin_end+1
return true
}
if(word(source,tokens,body_start,105,102,0,0,0,0,2))
{
var bp=body_start+1
if(bp>=body_end || tok_kind(tokens,bp)!=4 || tok_value(tokens,bp)!=40){return false}
var fp=fin_start
