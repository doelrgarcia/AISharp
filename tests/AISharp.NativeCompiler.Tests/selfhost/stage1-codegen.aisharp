module Stage1Codegen
intent "stage1-c-codegen"
fn tok_kind(tokens:&owned buffer, index:int)->int
ensures true
{
return bufferPeek(tokens,index*16)
}
fn tok_value(tokens:&owned buffer, index:int)->int
ensures true
{
let base=index*16
var v=bufferPeek(tokens,base+4)+bufferPeek(tokens,base+5)*256+bufferPeek(tokens,base+6)*65536
let b3=bufferPeek(tokens,base+7)
if(b3>=128){v=v-2147483647
v=v-1
v=v+(b3-128)*16777216}
else{v=v+b3*16777216}
return v
}
fn tok_start(tokens:&owned buffer, index:int)->int
ensures true
{
let base=index*16
return bufferPeek(tokens,base+8)+bufferPeek(tokens,base+9)*256+bufferPeek(tokens,base+10)*65536+bufferPeek(tokens,base+11)*16777216
}
fn tok_len(tokens:&owned buffer, index:int)->int
ensures true
{
let base=index*16
return bufferPeek(tokens,base+12)+bufferPeek(tokens,base+13)*256+bufferPeek(tokens,base+14)*65536+bufferPeek(tokens,base+15)*16777216
}
fn word(source:&owned buffer,tokens:&owned buffer,index:int,a:int,b:int,c:int,d:int,e:int,f:int,length:int)->bool
ensures true
{
if(tok_kind(tokens,index)!=1){return false}
if(length==3 && a==108 && b==101 && c==116 && tok_len(tokens,index)==5)
{
let cstart=tok_start(tokens,index)
if(bufferPeek(source,cstart)==99 && bufferPeek(source,cstart+1)==111 && bufferPeek(source,cstart+2)==110 && bufferPeek(source,cstart+3)==115 && bufferPeek(source,cstart+4)==116){return true}
}
if(tok_len(tokens,index)!=length){return false}
let start=tok_start(tokens,index)
if(length>0 && bufferPeek(source,start)!=a){return false}
if(length>1 && bufferPeek(source,start+1)!=b){return false}
if(length>2 && bufferPeek(source,start+2)!=c){return false}
if(length>3 && bufferPeek(source,start+3)!=d){return false}
if(length>4 && bufferPeek(source,start+4)!=e){return false}
if(length>5 && bufferPeek(source,start+5)!=f){return false}
return true
}
fn append_text(out:&mut owned buffer, pos:&mut int, text:string)->int
ensures true
{
let bytes=stringBytes(text)
var i=0
while(i<bufferSize(&bytes))
{
bufferWrite(out,*pos,bufferPeek(&bytes,i))
*pos=*pos+1
i=i+1
}
return 0
}
fn append_bytes(out:&mut owned buffer, pos:&mut int, bytes:owned buffer)->int
ensures true
{
var i=0
while(i<bufferSize(&bytes))
{
bufferWrite(out,*pos,bufferPeek(&bytes,i))
*pos=*pos+1
i=i+1
}
return 0
}
fn append_token(out:&mut owned buffer, pos:&mut int, source:&owned buffer, tokens:&owned buffer, index:int)->int
ensures true
{
let start=tok_start(tokens,index)
var i=0
while(i<tok_len(tokens,index))
{
bufferWrite(out,*pos,bufferPeek(source,start+i))
*pos=*pos+1
i=i+1
}
return 0
}
fn read32(data:&owned buffer, base:int)->int
ensures true
{
return bufferPeek(data,base)+bufferPeek(data,base+1)*256+bufferPeek(data,base+2)*65536+bufferPeek(data,base+3)*16777216
}
fn write32(data:&mut owned buffer, base:int, value:int)->int
ensures true
{
bufferWrite(data,base,value%256)
bufferWrite(data,base+1,(value/256)%256)
bufferWrite(data,base+2,(value/65536)%256)
bufferWrite(data,base+3,(value/16777216)%256)
return 0
}
fn tokens_text_equal(source:&owned buffer,tokens:&owned buffer,a:int,b:int)->bool
ensures true
{
if(tok_len(tokens,a)!=tok_len(tokens,b)){return false}
let astart=tok_start(tokens,a)
let bstart=tok_start(tokens,b)
var k=0
while(k<tok_len(tokens,a))
{
if(bufferPeek(source,astart+k)!=bufferPeek(source,bstart+k)){return false}
k=k+1
}
return true
}
fn find_local_type(source:&owned buffer,tokens:&owned buffer,name_index:int,limit:int)->int
ensures true
{
var pj=0
while(pj+2<limit)
{
if(tok_kind(tokens,pj)==1 && tokens_text_equal(source,tokens,pj,name_index) && tok_kind(tokens,pj+1)==4 && tok_value(tokens,pj+1)==58 && word(source,tokens,pj+2,111,98,106,101,99,116,6)){return 5}
pj=pj+1
}
var i=0
while(i+3<limit)
{
if(word(source,tokens,i,108,101,116,0,0,0,3) || word(source,tokens,i,118,97,114,0,0,0,3))
{
if(tokens_text_equal(source,tokens,i+1,name_index))
{
if(i+5<limit && tok_kind(tokens,i+2)==4 && tok_value(tokens,i+2)==61 && tok_kind(tokens,i+3)==4 && tok_value(tokens,i+3)==40 && word(source,tokens,i+4,111,98,106,101,99,116,6) && tok_kind(tokens,i+5)==4 && tok_value(tokens,i+5)==41){return 5}
if(i+5<limit && tok_kind(tokens,i+2)==4 && tok_value(tokens,i+2)==61 && tok_kind(tokens,i+3)==1 && word(source,tokens,i+4,97,115,0,0,0,0,2) && word(source,tokens,i+5,111,98,106,101,99,116,6)){return 5}
if(i+3<limit && tok_kind(tokens,i+2)==4 && tok_value(tokens,i+2)==61 && tok_kind(tokens,i+3)==1 && !(i+5<limit && word(source,tokens,i+4,97,115,0,0,0,0,2) && word(source,tokens,i+5,115,116,114,105,110,103,6)))
{
var q=0
while(q+4<i)
{
if((word(source,tokens,q,108,101,116,0,0,0,3) || word(source,tokens,q,118,97,114,0,0,0,3)) && tokens_text_equal(source,tokens,q+1,i+3))
{
if(tok_kind(tokens,q+2)==4 && tok_value(tokens,q+2)==58 && word(source,tokens,q+3,111,98,106,101,99,116,6)){return 5}
if(tok_kind(tokens,q+2)==4 && tok_value(tokens,q+2)==61 && tok_kind(tokens,q+3)==4 && tok_value(tokens,q+3)==40 && word(source,tokens,q+4,111,98,106,101,99,116,6)){return 5}
}
q=q+1
}
}
if(i+2<limit && tok_kind(tokens,i+1)==4 && tok_value(tokens,i+1)==58 && word(source,tokens,i+2,111,98,106,101,99,116,6)){return 5}
if(tok_kind(tokens,i+2)==4 && tok_value(tokens,i+2)==58)
{
if(word(source,tokens,i+3,98,111,111,108,0,0,4)){return 1}
if(word(source,tokens,i+3,115,116,114,105,110,103,6)){return 4}
if(word(source,tokens,i+3,111,98,106,101,99,116,6)){return 5}
if(word(source,tokens,i+3,111,119,110,101,100,0,5)){return 3}
if(word(source,tokens,i+3,117,105,110,116,0,0,4) || word(source,tokens,i+3,117,108,111,110,103,0,5) || word(source,tokens,i+3,110,117,105,110,116,0,5)){return 6}
if(word(source,tokens,i+3,102,108,111,97,116,0,5)){return 7}
if(word(source,tokens,i+3,100,111,117,98,108,101,6)){return 8}
if(word(source,tokens,i+3,108,111,110,103,0,0,4)){if(i+9<limit && tok_kind(tokens,i+4)==4 && tok_value(tokens,i+4)==61 && tok_len(tokens,i+5)==9 && bufferPeek(source,tok_start(tokens,i+5))==117 && tok_kind(tokens,i+6)==4 && tok_value(tokens,i+6)==40 && tok_kind(tokens,i+7)==4 && tok_value(tokens,i+7)==40 && word(source,tokens,i+8,108,111,110,103,0,0,4) && tok_kind(tokens,i+9)==4 && tok_value(tokens,i+9)==41){return 9}
return 0}
if(tok_kind(tokens,i+3)==1){return 0}
}
}
}
i=i+1
}
return 0
}
fn emit_type_code(out:&mut owned buffer,pos:&mut int,code:int)->int
ensures true
{
if(code==1){append_text(&mut *out,&mut *pos,"bool ")}else{if(code==2){append_text(&mut *out,&mut *pos,"ai_buffer* ")}else{if(code==3){append_text(&mut *out,&mut *pos,"ai_buffer ")}else{if(code==5){append_text(&mut *out,&mut *pos,"int32_t* ")}else{if(code==12){append_text(&mut *out,&mut *pos,"ai_object ")}else{if(code==4){append_text(&mut *out,&mut *pos,"ai_string ")}else{if(code==9){append_text(&mut *out,&mut *pos,"void* ")}else{append_text(&mut *out,&mut *pos,"int32_t ")}}}}}}}
return 0
}
fn skip_type(source:&owned buffer,tokens:&owned buffer,tp:&mut int,limit:int,error:&mut int)->int
ensures true
{
*tp=*tp+1
if(*tp>=limit || tok_kind(tokens,*tp)!=1){*error=1
return 0}
*tp=*tp+1
if(*tp<limit && tok_kind(tokens,*tp)==4 && tok_value(tokens,*tp)==60)
{
*tp=*tp+1
while(*tp<limit && !(tok_kind(tokens,*tp)==4 && tok_value(tokens,*tp)==62))
{
if(tok_kind(tokens,*tp)==1){*tp=*tp+1}
else
{
if(tok_kind(tokens,*tp)==4 && tok_value(tokens,*tp)==44){*tp=*tp+1}else{*error=1
return 0}
}
}
if(*tp>=limit || tok_kind(tokens,*tp)!=4 || tok_value(tokens,*tp)!=62){*error=1
return 0}
*tp=*tp+1
}
if(*tp<limit && tok_kind(tokens,*tp)==4 && tok_value(tokens,*tp)==58)
{
while(*tp<limit && !(tok_kind(tokens,*tp)==4 && tok_value(tokens,*tp)==61)){*tp=*tp+1}
}
while(*tp<limit && !(tok_kind(tokens,*tp)==4 && tok_value(tokens,*tp)==61)){*tp=*tp+1}
if(*tp>=limit || tok_kind(tokens,*tp)!=4 || tok_value(tokens,*tp)!=61){*error=1
return 0}
*tp=*tp+1
if(*tp>=limit || tok_kind(tokens,*tp)!=4 || tok_value(tokens,*tp)!=123)
{
while(*tp<limit && !(word(source,tokens,*tp,102,110,0,0,0,0,2) || word(source,tokens,*tp,116,121,112,101,0,0,4) || word(source,tokens,*tp,99,108,97,115,115,0,5) || word(source,tokens,*tp,115,116,114,117,99,116,6) || word(source,tokens,*tp,114,101,99,111,114,100,6) || word(source,tokens,*tp,105,110,116,101,114,102,9) || word(source,tokens,*tp,101,110,117,109,0,0,4) || word(source,tokens,*tp,100,101,108,101,103,97,8) || word(source,tokens,*tp,101,120,116,101,110,115,9) || word(source,tokens,*tp,97,115,121,110,99,0,5) || word(source,tokens,*tp,115,101,97,108,101,100,6) || word(source,tokens,*tp,97,98,115,116,114,97,8) || word(source,tokens,*tp,118,105,114,116,117,97,7) || word(source,tokens,*tp,111,118,101,114,114,105,8) || word(source,tokens,*tp,112,97,114,116,105,97,7) || word(source,tokens,*tp,109,97,110,97,103,101,7) || word(source,tokens,*tp,117,110,109,97,110,97,9) || word(source,tokens,*tp,103,101,116,0,0,0,3) || word(source,tokens,*tp,115,101,116,0,0,0,3) || word(source,tokens,*tp,99,111,110,115,116,114,11))){*tp=*tp+1}
return 0
}
*tp=*tp+1
skip_block(tokens,&mut *tp,limit,&mut *error)
return 0
}
fn is_property(source:&owned buffer,tokens:&owned buffer,name_index:int,limit:int)->bool
ensures true
{
var i=0
while(i+1<limit)
{
if(word(source,tokens,i,103,101,116,0,0,0,3) || word(source,tokens,i,115,101,116,0,0,0,3))
{
if(tokens_text_equal(source,tokens,i+1,name_index)){return true}
}
i=i+1
}
return false
}
fn skip_constructor(tokens:&owned buffer,tp:&mut int,limit:int,error:&mut int)->int
ensures true
{
*tp=*tp+1
if(*tp>=limit || tok_kind(tokens,*tp)!=1){*error=1
return 0}
*tp=*tp+1
while(*error==0 && *tp<limit)
{
if(tok_kind(tokens,*tp)==4 && tok_value(tokens,*tp)==123)
{
*tp=*tp+1
skip_block(tokens,&mut *tp,limit,&mut *error)
return 0
}
*tp=*tp+1
}
*error=1
return 0
}
fn emit_args_with_base(source:&owned buffer,tokens:&owned buffer,tp:&mut int,limit:int,out:&mut owned buffer,pos:&mut int,error:&mut int,base_index:int)->int
ensures true
{
append_text(&mut *out,&mut *pos,"(")
append_token(&mut *out,&mut *pos,source,tokens,base_index)
if(!(*tp<limit && tok_kind(tokens,*tp)==4 && tok_value(tokens,*tp)==40)){*error=1
return 0}
*tp=*tp+1
if(!(*tp<limit && tok_kind(tokens,*tp)==4 && tok_value(tokens,*tp)==41))
{
append_text(&mut *out,&mut *pos,", ")
var more=1
while(*error==0 && more!=0)
{
emit_logical(source,tokens,&mut *tp,limit,&mut *out,&mut *pos,&mut *error)
if(*error!=0){return 0}
if(*tp<limit && tok_kind(tokens,*tp)==4 && tok_value(tokens,*tp)==44)
{
append_text(&mut *out,&mut *pos,", ")
*tp=*tp+1
}
else{more=0}
}
}
if(*tp>=limit || tok_kind(tokens,*tp)!=4 || tok_value(tokens,*tp)!=41){*error=1
return 0}
*tp=*tp+1
append_text(&mut *out,&mut *pos,")")
return 0
}
fn skip_extension(tokens:&owned buffer,tp:&mut int,limit:int,error:&mut int)->int
ensures true
{
*tp=*tp+1
while(*tp<limit && !(tok_kind(tokens,*tp)==4 && tok_value(tokens,*tp)==123)){*tp=*tp+1}
if(*tp>=limit){*error=1
return 0}
*tp=*tp+1
skip_block(tokens,&mut *tp,limit,&mut *error)
return 0
}
fn emit_extension_block(source:&owned buffer,tokens:&owned buffer,cursor:&mut int,limit:int,out:&mut owned buffer,pos:&mut int,error:&mut int)->int
ensures true
{
*cursor=*cursor+1
let type_index=*cursor
*cursor=*cursor+1
if(*cursor>=limit || tok_kind(tokens,*cursor)!=4 || tok_value(tokens,*cursor)!=123){*error=1
return 0}
*cursor=*cursor+1
while(*error==0 && *cursor<limit && !(tok_kind(tokens,*cursor)==4 && tok_value(tokens,*cursor)==125))
{
if(!word(source,tokens,*cursor,102,110,0,0,0,0,2)){*error=1
return 0}
var name=0
var rettype=0
var pcount=0
var pnames=buffer(128)
var pbool=buffer(32)
var ptypes=buffer(128)
parse_header(source,tokens,&mut *cursor,limit,&mut name,&mut pnames,&mut pbool,&mut ptypes,&mut pcount,&mut rettype,&mut *error)
if(*error!=0){return 0}
emit_ret_type(&mut *out,&mut *pos,source,tokens,rettype,limit)
append_text(&mut *out,&mut *pos," ")
append_token(&mut *out,&mut *pos,source,tokens,name)
append_text(&mut *out,&mut *pos,"(")
append_token(&mut *out,&mut *pos,source,tokens,type_index)
append_text(&mut *out,&mut *pos," this")
if(pcount>0)
{
append_text(&mut *out,&mut *pos,", ")
emit_params(&mut *out,&mut *pos,source,tokens,&pnames,&pbool,&ptypes,pcount,limit)
}
append_text(&mut *out,&mut *pos,") {\n")
var tp=*cursor
emit_block_scope(source,tokens,&mut tp,limit,&mut *out,&mut *pos,&mut *error,0)
if(*error!=0){return 0}
if(tp>=limit || tok_kind(tokens,tp)!=4 || tok_value(tokens,tp)!=125){*error=1
return 0}
tp=tp+1
append_text(&mut *out,&mut *pos,"}\n")
*cursor=tp
}
if(*cursor>=limit){*error=1
return 0}
*cursor=*cursor+1
return 0
}
fn is_managed_type(source:&owned buffer,tokens:&owned buffer,name_index:int,limit:int)->bool
ensures true
{
var i=0
while(i+2<limit)
{
if((word(source,tokens,i,109,97,110,97,103,101,7) || word(source,tokens,i,117,110,109,97,110,97,9) || word(source,tokens,i,100,101,108,101,103,97,8)) && word(source,tokens,i+1,102,110,0,0,0,0,2))
{
if(tokens_text_equal(source,tokens,i+2,name_index)){return true}
}
i=i+1
}
return false
}
fn emit_managed_types(source:&owned buffer,tokens:&owned buffer,limit:int,out:&mut owned buffer,pos:&mut int,error:&mut int)->int
ensures true
{
var cursor=4
while(*error==0 && cursor<limit)
{
while(word(source,tokens,cursor,97,115,121,110,99,0,5)){cursor=cursor+1}
while(word(source,tokens,cursor,110,97,109,101,115,112,9)){cursor=cursor+1
while(cursor<limit && !newline_before(source,tokens,cursor)){cursor=cursor+1}}
while(word(source,tokens,cursor,102,105,108,101,0,0,4)){cursor=cursor+1}
while(word(source,tokens,cursor,114,101,102,0,0,0,3)){cursor=cursor+1}
while(word(source,tokens,cursor,97,108,105,97,115,0,5)){cursor=cursor+1
while(cursor<limit && !newline_before(source,tokens,cursor)){cursor=cursor+1}}
while(word(source,tokens,cursor,101,120,116,101,114,110,6)){cursor=cursor+1
while(cursor<limit && !newline_before(source,tokens,cursor)){cursor=cursor+1}}
while(word(source,tokens,cursor,117,110,115,97,102,101,6)){cursor=cursor+1}
while(word(source,tokens,cursor,101,110,117,109,0,0,4)){skip_enum(tokens,&mut cursor,limit,&mut *error)}
while(word(source,tokens,cursor,97,108,105,97,115,0,5)){cursor=cursor+1
while(cursor<limit && !newline_before(source,tokens,cursor)){cursor=cursor+1}}
while(word(source,tokens,cursor,112,97,114,116,105,97,7)){skip_partial(tokens,&mut cursor,limit,&mut *error)}
while(word(source,tokens,cursor,118,105,114,116,117,97,7)){cursor=cursor+1}
while(word(source,tokens,cursor,115,101,97,108,101,100,6)){cursor=cursor+1}
while(word(source,tokens,cursor,118,105,114,116,117,97,7)){cursor=cursor+1}
while(word(source,tokens,cursor,115,101,97,108,101,100,6)){cursor=cursor+1}
while(word(source,tokens,cursor,105,110,116,101,114,102,9)){skip_interface(tokens,&mut cursor,limit,&mut *error)}
while(word(source,tokens,cursor,97,100,100,0,0,0,3) || word(source,tokens,cursor,114,101,109,111,118,101,6)){skip_accessor(tokens,&mut cursor,limit,&mut *error)}
while(word(source,tokens,cursor,97,98,115,116,114,97,8)){skip_abstract_decl(source,tokens,&mut cursor,limit,&mut *error)}
while(word(source,tokens,cursor,111,118,101,114,114,105,8)){skip_override_decl(source,tokens,&mut cursor,limit,&mut *error)}
if(is_type_kw(source,tokens,cursor) || word(source,tokens,cursor,99,108,97,115,115,0,5)){skip_type(source,tokens,&mut cursor,limit,&mut *error)}
else
{
if(word(source,tokens,cursor,101,120,116,101,110,115,9)){skip_extension(tokens,&mut cursor,limit,&mut *error)}
else
{
if(word(source,tokens,cursor,103,101,116,0,0,0,3) || word(source,tokens,cursor,115,101,116,0,0,0,3)){skip_accessor(tokens,&mut cursor,limit,&mut *error)}
else
{
if(word(source,tokens,cursor,99,111,110,115,116,114,11)){skip_constructor(tokens,&mut cursor,limit,&mut *error)}
else
{
if(word(source,tokens,cursor,109,97,110,97,103,101,7) || word(source,tokens,cursor,117,110,109,97,110,97,9) || word(source,tokens,cursor,100,101,108,101,103,97,8))
{
cursor=cursor+1
if(!word(source,tokens,cursor,102,110,0,0,0,0,2)){*error=1
return 0}
cursor=cursor+1
let name=cursor
cursor=cursor+1
if(cursor>=limit || tok_kind(tokens,cursor)!=4 || tok_value(tokens,cursor)!=40){*error=1
return 0}
cursor=cursor+1
var pnames=buffer(128)
var pbool=buffer(32)
var ptypes=buffer(128)
var pcount=0
while(*error==0 && cursor<limit && !(tok_kind(tokens,cursor)==4 && tok_value(tokens,cursor)==41))
{
if(tok_kind(tokens,cursor)!=1){*error=1
return 0}
write32(&mut pnames,pcount*4,cursor)
cursor=cursor+1
if(cursor>=limit || tok_kind(tokens,cursor)!=4 || tok_value(tokens,cursor)!=58){*error=1
return 0}
cursor=cursor+1
let type_index=cursor
var tcode=0
if(word(source,tokens,type_index,98,111,111,108,0,0,4)){tcode=1}
if(word(source,tokens,type_index,115,116,114,105,110,103,6)){tcode=4}
if(word(source,tokens,type_index,111,98,106,101,99,116,6)){tcode=12}
bufferWrite(&mut pbool,pcount,tcode)
cursor=cursor+1
pcount=pcount+1
if(cursor<limit && tok_kind(tokens,cursor)==4 && (tok_value(tokens,cursor)==44 || tok_value(tokens,cursor)==59)){cursor=cursor+1}
}
if(cursor>=limit || tok_kind(tokens,cursor)!=4 || tok_value(tokens,cursor)!=41){*error=1
return 0}
cursor=cursor+1
if(cursor>=limit || tok_kind(tokens,cursor)!=4 || tok_value(tokens,cursor)!=45){*error=1
return 0}
cursor=cursor+1
if(cursor>=limit || tok_kind(tokens,cursor)!=4 || tok_value(tokens,cursor)!=62){*error=1
return 0}
cursor=cursor+1
let rettype=cursor
cursor=cursor+1
if(cursor>=limit || tok_kind(tokens,cursor)!=4 || tok_value(tokens,cursor)!=59){*error=1
return 0}
cursor=cursor+1
append_text(&mut *out,&mut *pos,"typedef ")
emit_ret_type(&mut *out,&mut *pos,source,tokens,rettype,limit)
append_text(&mut *out,&mut *pos," (*")
append_token(&mut *out,&mut *pos,source,tokens,name)
append_text(&mut *out,&mut *pos,")(")
emit_params(&mut *out,&mut *pos,source,tokens,&pnames,&pbool,&ptypes,pcount,limit)
append_text(&mut *out,&mut *pos,");\n")
}
else
{
if(word(source,tokens,cursor,102,110,0,0,0,0,2))
{
var fname=0
var fret=0
var fcount=0
var fnames=buffer(128)
var fbool=buffer(32)
var ftypes=buffer(128)
parse_header(source,tokens,&mut cursor,limit,&mut fname,&mut fnames,&mut fbool,&mut ftypes,&mut fcount,&mut fret,&mut *error)
if(*error!=0){return 0}
skip_block(tokens,&mut cursor,limit,&mut *error)
}
else{*error=1
return 0}
}
}
}
}
}
}
return 0
}
fn skip_abstract_decl(source:&owned buffer,tokens:&owned buffer,tp:&mut int,limit:int,error:&mut int)->int
ensures true
{
*tp=*tp+1
if(*tp>=limit){*error=1
return 0}
if(is_type_kw(source,tokens,*tp) || word(source,tokens,*tp,99,108,97,115,115,0,5)){skip_type(source,tokens,&mut *tp,limit,&mut *error)}
else
{
while(*tp<limit)
{
if(tok_kind(tokens,*tp)==4 && tok_value(tokens,*tp)==59)
{
