fn function_returns_buffer(source:&owned buffer,tokens:&owned buffer,name_index:int,limit:int)->bool
ensures true
{
var i=0
while(i+3<limit)
{
if(word(source,tokens,i,102,110,0,0,0,0,2) && tokens_text_equal(source,tokens,i+1,name_index))
{
