 {
 if(k==0){append_text(&mut *out,&mut *pos,"_")}else{append_text(&mut *out,&mut *pos,"__")}
 mangle_type(source,tokens,read32(gargs,k*4),limit,&mut *out,&mut *pos)
 k=k+1
 }
 return 0
}
fn registry_has(reg:&owned buffer,regpos:int,key:&owned buffer,keylen:int)->bool
ensures true
{
 var i=0
 while(i+4<=regpos)
 {
 let n=read32(reg,i)
 if(n==keylen)
 {
 var same=1
 var j=0
 while(j<n)
 {
 if(bufferPeek(reg,i+4+j)!=bufferPeek(key,j)){same=0}
 j=j+1
 }
 if(same==1){return true}
 }
 i=i+4+n
 }
 return false
}
fn ensure_field_deps(source:&owned buffer,tokens:&owned buffer,start:int,end:int,limit:int,gparams:&owned buffer,pcount:int,gargs:&owned buffer,reg:&mut owned buffer,regpos:&mut int,out:&mut owned buffer,pos:&mut int,error:&mut int)->int
ensures true
{
 var sargs=buffer(256)
 var i=start
 while(*error==0 && i<end)
 {
 var advanced=0
 if(tok_kind(tokens,i)==1 && param_lookup(source,tokens,i,gparams,pcount)<0)
 {
 let lt=find_generic_app(source,tokens,i,limit)
 if(lt>=0)
 {
 var scount=0
 var j=lt+1
 while(*error==0 && j<limit && !(tok_kind(tokens,j)==4 && tok_value(tokens,j)==62))
 {
 let e2=skip_type_expr(source,tokens,j,limit)
 var astart=j
 let pj=param_lookup(source,tokens,j,gparams,pcount)
 if(pj>=0){astart=read32(gargs,pj*4)}
 else
 {
 if(type_expr_has_param(source,tokens,j,e2,gparams,pcount)){*error=1
 return 0}
 }
 write32(&mut sargs,scount*4,astart)
 scount=scount+1
 j=e2
 if(j<limit && tok_kind(tokens,j)==4 && tok_value(tokens,j)==44){j=j+1}
 }
 if(scount==0){*error=1
 return 0}
 var k=0
 while(*error==0 && k<scount)
 {
 let astart=read32(&sargs,k*4)
 let aend=skip_type_expr(source,tokens,astart,limit)
 ensure_field_deps(source,tokens,astart,aend,limit,gparams,pcount,gargs,&mut *reg,&mut *regpos,&mut *out,&mut *pos,&mut *error)
 k=k+1
 }
 instantiation_ensure(source,tokens,i,&sargs,scount,limit,&mut *reg,&mut *regpos,&mut *out,&mut *pos,&mut *error)
 if(*error!=0){return 0}
 let after=skip_angle(tokens,lt,limit)
 if(after>i){i=after}else{i=i+1}
 advanced=1
 }
 }
 if(advanced==0){i=i+1}
 }
 return 0
}
fn instantiation_ensure(source:&owned buffer,tokens:&owned buffer,name_index:int,gargs:&owned buffer,acount:int,limit:int,reg:&mut owned buffer,regpos:&mut int,out:&mut owned buffer,pos:&mut int,error:&mut int)->int
ensures true
{
 if(*error!=0){return 0}
