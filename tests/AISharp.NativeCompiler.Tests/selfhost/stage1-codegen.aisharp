 ensure_field_deps(source,tokens,tstart,tend,limit,&gparams,pcount,gargs,&mut *reg,&mut *regpos,&mut *out,&mut *pos,&mut *error)
 if(*error!=0){return 0}
 c=tend
 if(c<bend && tok_kind(tokens,c)==4 && tok_value(tokens,c)==91)
 {
 c=c+1
 while(c<bend && !(tok_kind(tokens,c)==4 && tok_value(tokens,c)==93)){c=c+1}
 if(c<bend){c=c+1}
 }
 if(c<bend && tok_kind(tokens,c)==4 && (tok_value(tokens,c)==44 || tok_value(tokens,c)==59)){c=c+1}
 }
 append_text(&mut *out,&mut *pos,"typedef struct { ")
 c=body+1
 while(*error==0 && c<bend)
 {
 c=skip_field_attrs(source,tokens,c,limit)
 if(c>=bend){break}
 let fname=c
 c=c+1
 if(c>=limit || tok_kind(tokens,c)!=4 || tok_value(tokens,c)!=58){*error=1
 return 0}
 c=c+1
