if(has_ret_expr)
{
append_text(&mut *out,&mut *pos,"    ")
emit_ret_type(&mut *out,&mut *pos,source,tokens,rettype,limit)
append_text(&mut *out,&mut *pos," ai_rv;\n")
}
var is_generator=body_has_yield(source,tokens,cursor,limit)
if(is_generator)
{
append_text(&mut *out,&mut *pos,"    ai_buffer ai_yield=ai_buffer_new(64);\n    int32_t ai_yield_len=0;\n")
}
var tp=cursor
var rel=buffer(1024)
var relc=0
var pi=0
while(pi<pcount)
{
 let pcode=bufferPeek(&pbool,pi)
 let pname=read32(&pnames,pi*4)
 if(pcode==3)
 {
  write32(&mut rel,relc*12,pname)
  write32(&mut rel,relc*12+4,2147483647)
  write32(&mut rel,relc*12+8,0)
  relc=relc+1
 }
 else
 {
  if(pcode==7)
  {
   let ptok=read32(&ptypes,pi*4)
   let pcnt=product_owned_count(source,tokens,ptok,limit)
   var pk=pcnt-1
   while(pk>=0)
   {
    let pf=product_owned_field_k(source,tokens,ptok,pk,limit)
    if(pf>=0)
    {
     write32(&mut rel,relc*12,pname)
     write32(&mut rel,relc*12+4,2147483647)
     write32(&mut rel,relc*12+8,pf)
     relc=relc+1
    }
    pk=pk-1
   }
  }
 }
 pi=pi+1
}
let param_count=relc
emit_block(source,tokens,&mut tp,limit,&mut *out,&mut *pos,&mut *error,0,&mut rel,&mut relc,1,0)
if(*error!=0){*error=1
return 0}
if(tp>=limit || tok_kind(tokens,tp)!=4 || tok_value(tokens,tp)!=125){*error=1
return 0}
tp=tp+1
