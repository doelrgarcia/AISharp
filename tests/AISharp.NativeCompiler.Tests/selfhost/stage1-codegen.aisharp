fn check_program(source:&owned buffer,tokens:&owned buffer,limit:int)->int
ensures true
{
var fnnames=buffer(1024)
var fntypes=buffer(512)
var fncount=0
collect_functions(source,tokens,limit,&mut fnnames,&mut fntypes,&mut fncount)
var pt=buffer(4096)
collect_products(source,tokens,limit,&mut pt)
var i=0
while(i<fncount)
{
let code=check_function(source,tokens,read32(&fnnames,i*4),limit,&fnnames,&fntypes,fncount,&pt)
if(code!=0){return code}
i=i+1
}
return 0
}
