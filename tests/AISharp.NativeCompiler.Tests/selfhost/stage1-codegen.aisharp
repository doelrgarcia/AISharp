fn emit_token_slice(source:&owned buffer,tokens:&owned buffer,start:int,end:int,limit:int,out:&mut owned buffer,pos:&mut int,error:&mut int,loop_depth:int)->int
ensures true
{
let n=end-start
if(n<=0){return 0}
var sub=buffer(n*16)
var k=0
while(k<n)
{
var b=0
while(b<16)
{
bufferWrite(&mut sub,k*16+b,bufferPeek(tokens,(start+k)*16+b))
b=b+1
}
k=k+1
}
var sp=0
return emit_block_scope(source,&sub,&mut sp,n,&mut *out,&mut *pos,&mut *error,loop_depth)
}
