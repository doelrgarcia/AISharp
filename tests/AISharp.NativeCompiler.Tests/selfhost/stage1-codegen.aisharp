var pnames=buffer(128)
var pbool=buffer(32)
var ptypes=buffer(128)
parse_header(source,tokens,&mut cursor,limit,&mut name,&mut pnames,&mut pbool,&mut ptypes,&mut pcount,&mut rettype,&mut *error)
if(*error!=0){return 0}
emit_ret_type(&mut *out,&mut *pos,source,tokens,rettype,limit)
append_text(&mut *out,&mut *pos," ")
emit_method_name(&mut *out,&mut *pos,source,tokens,name,&pnames,&ptypes,pcount,limit)
append_text(&mut *out,&mut *pos,"(")
emit_params(&mut *out,&mut *pos,source,tokens,&pnames,&pbool,&ptypes,pcount,limit)
append_text(&mut *out,&mut *pos,");\n")
skip_block(tokens,&mut cursor,limit,&mut *error)
}
}
return 0
