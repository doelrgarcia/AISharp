if(c<limit && tok_kind(tokens,c)==4 && tok_value(tokens,c)==58){c=c+1
if(c<limit){c=c+1}}
if(c<limit && tok_kind(tokens,c)==4 && tok_value(tokens,c)==44){c=c+1}
