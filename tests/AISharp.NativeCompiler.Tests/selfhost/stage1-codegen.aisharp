}
fn mask_bit(k:int)->int
ensures true
{
var m=1
var i=0
while(i<k)
{
m=m*2
i=i+1
}
return m
}
fn has_bit(value:int,k:int)->bool
ensures true
{
if(k<0){return false}
let b=mask_bit(k)
