emit_releases(&mut *out,&mut *pos,source,tokens,&rel,0,param_count,limit)
append_text(&mut *out,&mut *pos,"}\n")
cursor=tp
}
}
if(has_main==0){*error=1}
return 0
}
fn value_type_code(source:&owned buffer,tokens:&owned buffer,index:int)->int
ensures true
{
if(tok_kind(tokens,index)!=1){return 8}
if(tok_equals(source,tokens,index,"int")){return 0}
if(tok_equals(source,tokens,index,"bool")){return 1}
if(tok_equals(source,tokens,index,"long")){return 2}
if(tok_equals(source,tokens,index,"ulong")){return 2}
if(tok_equals(source,tokens,index,"string")){return 3}
if(tok_equals(source,tokens,index,"char")){return 4}
if(tok_equals(source,tokens,index,"ushort")){return 4}
if(tok_equals(source,tokens,index,"byte")){return 0}
if(tok_equals(source,tokens,index,"sbyte")){return 0}
if(tok_equals(source,tokens,index,"short")){return 0}
if(tok_equals(source,tokens,index,"uint")){return 0}
if(tok_equals(source,tokens,index,"nint")){return 0}
if(tok_equals(source,tokens,index,"nuint")){return 0}
if(tok_equals(source,tokens,index,"float")){return 6}
if(tok_equals(source,tokens,index,"double")){return 7}
if(tok_equals(source,tokens,index,"buffer")){return 5}
if(tok_equals(source,tokens,index,"void")){return 9}
return 8
}
fn symbol_find(source:&owned buffer,tokens:&owned buffer,name_index:int,syms:&owned buffer,count:int,depth:int)->int
ensures true
{
var i=count-1
while(i>=0)
{
if(read32(syms,i*16+8)<=depth && tokens_text_equal(source,tokens,read32(syms,i*16),name_index)){return i}
i=i-1
}
return -1
}
fn symbol_add(syms:&mut owned buffer,countp:&mut int,name_index:int,ty:int,mutable:int,moved:int,scope:int,init_mask:int,moved_mask:int)->int
ensures true
{
write32(&mut *syms,*countp*16,name_index)
bufferWrite(&mut *syms,*countp*16+4,ty)
bufferWrite(&mut *syms,*countp*16+5,mutable)
bufferWrite(&mut *syms,*countp*16+6,moved)
bufferWrite(&mut *syms,*countp*16+7,init_mask)
write32(&mut *syms,*countp*16+8,scope)
bufferWrite(&mut *syms,*countp*16+12,moved_mask)
*countp=*countp+1
return 0
}
fn statement_end(source:&owned buffer,tokens:&owned buffer,start:int,limit:int,endlimit:int)->int
ensures true
{
var j=start
while(j<endlimit)
{
if(j>start && newline_before(source,tokens,j)){return j}
if(tok_kind(tokens,j)==4 && (tok_value(tokens,j)==125 || tok_value(tokens,j)==123)){return j}
if(tok_kind(tokens,j)==4 && tok_value(tokens,j)==59){return j}
j=j+1
}
return j
}
