 ensure_field_deps(source,tokens,astart,aend,limit,&noparams,0,&noargs,&mut reg,&mut regpos,&mut *out,&mut *pos,&mut *error)
 k=k+1
 }
 instantiation_ensure(source,tokens,defname,&gargs,acount,limit,&mut reg,&mut regpos,&mut *out,&mut *pos,&mut *error)
 }
 }
 }
 uj=uj+1
 }
 di=di+1
 }
 }
 return 0
