if(*error!=0){return 0}
if(cursor>=limit){break}
if(is_type_kw(source,tokens,cursor) || word(source,tokens,cursor,99,108,97,115,115,0,5)){skip_type(source,tokens,&mut cursor,limit,&mut *error)}else{
