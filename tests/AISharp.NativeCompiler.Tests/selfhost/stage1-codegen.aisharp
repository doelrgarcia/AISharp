append_text(&mut *out,&mut *pos," ")
return 0}
if(code==8){append_token(&mut *out,&mut *pos,source,tokens,read32(ptypes,index*4))
append_text(&mut *out,&mut *pos,"* ")
return 0}
if(code==13){append_text(&mut *out,&mut *pos,"int64_t ")
return 0}
if(code==14){append_text(&mut *out,&mut *pos,"uint16_t ")
return 0}
