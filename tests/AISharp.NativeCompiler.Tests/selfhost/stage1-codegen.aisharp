fn emit_subst_ctype(source:&owned buffer,tokens:&owned buffer,start:int,limit:int,gparams:&owned buffer,pcount:int,gargs:&owned buffer,out:&mut owned buffer,pos:&mut int)->int
ensures true
{
 var i=start
 var ptr=0
 var again=1
 while(i<limit && again==1)
 {
 again=0
 if(tok_kind(tokens,i)==4 && (tok_value(tokens,i)==38 || tok_value(tokens,i)==42)){ptr=ptr+1
 i=i+1
 again=1}
 else
 {
 if(tok_equals(source,tokens,i,"owned") || tok_equals(source,tokens,i,"mut") || tok_equals(source,tokens,i,"ref") || tok_equals(source,tokens,i,"scoped")){i=i+1
 again=1}
 }
 }
 if(i>=limit){return limit}
 var handled=0
 if(tok_kind(tokens,i)==1)
 {
 let pj=param_lookup(source,tokens,i,gparams,pcount)
 if(pj>=0)
 {
 i=emit_ctype_concrete(source,tokens,read32(gargs,pj*4),limit,&mut *out,&mut *pos)
 handled=1
 }
 else
 {
 if(find_generic_app(source,tokens,i,limit)>=0){i=mangle_subst(source,tokens,i,limit,gparams,pcount,gargs,&mut *out,&mut *pos)
 handled=1}
 }
 }
 if(handled==0){i=emit_ctype_concrete(source,tokens,start,limit,&mut *out,&mut *pos)
 return i}
 if(ptr>0){append_text(&mut *out,&mut *pos,"*")}
 return i
}
fn append_span(out:&mut owned buffer,pos:&mut int,src:&owned buffer,count:int)->int
ensures true
{
 var i=0
 while(i<count)
 {
 bufferWrite(&mut *out,*pos,bufferPeek(src,i))
 *pos=*pos+1
 i=i+1
 }
 return 0
}
fn emit_inst_key(source:&owned buffer,tokens:&owned buffer,name_index:int,gargs:&owned buffer,acount:int,limit:int,out:&mut owned buffer,pos:&mut int)->int
ensures true
{
