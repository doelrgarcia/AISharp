cursor=cursor+1
if(cursor>=limit || tok_kind(tokens,cursor)!=4 || tok_value(tokens,cursor)!=62){*error=1
return 0}
cursor=cursor+1
if(cursor>=limit || tok_kind(tokens,cursor)!=1){*error=1
