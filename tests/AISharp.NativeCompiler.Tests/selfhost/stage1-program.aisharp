module Stage1Program
intent "stage1-program-parser"
fn tok_kind(tokens:&owned buffer, index:int)->int
ensures true
{
return bufferPeek(tokens,index*16)
}
fn tok_value(tokens:&owned buffer, index:int)->int
ensures true
{
let base=index*16
return bufferPeek(tokens,base+4)+bufferPeek(tokens,base+5)*256+bufferPeek(tokens,base+6)*65536+bufferPeek(tokens,base+7)*16777216
}
fn tok_start(tokens:&owned buffer, index:int)->int
ensures true
{
let base=index*16
return bufferPeek(tokens,base+8)+bufferPeek(tokens,base+9)*256+bufferPeek(tokens,base+10)*65536+bufferPeek(tokens,base+11)*16777216
}
fn tok_len(tokens:&owned buffer, index:int)->int
ensures true
{
let base=index*16
return bufferPeek(tokens,base+12)+bufferPeek(tokens,base+13)*256+bufferPeek(tokens,base+14)*65536+bufferPeek(tokens,base+15)*16777216
}
fn word(source:&owned buffer,tokens:&owned buffer,index:int,a:int,b:int,c:int,d:int,e:int,f:int,length:int)->bool
ensures true
{
if(tok_kind(tokens,index)!=1 || tok_len(tokens,index)!=length)
{
return false
}
let start=tok_start(tokens,index)
if(length>0 && bufferPeek(source,start)!=a){return false}
if(length>1 && bufferPeek(source,start+1)!=b){return false}
if(length>2 && bufferPeek(source,start+2)!=c){return false}
if(length>3 && bufferPeek(source,start+3)!=d){return false}
if(length>4 && bufferPeek(source,start+4)!=e){return false}
if(length>5 && bufferPeek(source,start+5)!=f){return false}
return true
}
fn read32(data:&owned buffer, base:int)->int
ensures true
{
return bufferPeek(data,base)+bufferPeek(data,base+1)*256+bufferPeek(data,base+2)*65536+bufferPeek(data,base+3)*16777216
}
fn write32(data:&mut owned buffer, base:int, value:int)->int
ensures true
{
bufferWrite(data,base,value%256)
bufferWrite(data,base+1,(value/256)%256)
bufferWrite(data,base+2,(value/65536)%256)
bufferWrite(data,base+3,(value/16777216)%256)
return 0
}
fn name_equal(source:&owned buffer,tokens:&owned buffer,index:int,starts:&owned buffer,lens:&owned buffer,slot:int)->bool
ensures true
{
if(bufferPeek(lens,slot*4)+bufferPeek(lens,slot*4+1)*256+bufferPeek(lens,slot*4+2)*65536+bufferPeek(lens,slot*4+3)*16777216!=tok_len(tokens,index)){return false}
var k=0
let a=tok_start(tokens,index)
let b=bufferPeek(starts,slot*4)+bufferPeek(starts,slot*4+1)*256+bufferPeek(starts,slot*4+2)*65536+bufferPeek(starts,slot*4+3)*16777216
while(k<tok_len(tokens,index))
{
if(bufferPeek(source,a+k)!=bufferPeek(source,b+k)){return false}
k=k+1
}
return true
}
fn lookup(source:&owned buffer,tokens:&owned buffer,index:int,starts:&owned buffer,lens:&owned buffer,defined:&owned buffer)->int
ensures true
{
var slot=0
while(slot<32)
{
if(bufferPeek(defined,slot)!=0 && name_equal(source,tokens,index,starts,lens,slot)){return slot}
slot=slot+1
}
return -1
}
fn free_slot(defined:&owned buffer)->int
ensures true
{
var slot=0
while(slot<32)
{
if(bufferPeek(defined,slot)==0){return slot}
slot=slot+1
}
return -1
}
fn tokens_text_equal(source:&owned buffer,tokens:&owned buffer,a:int,b:int)->bool
ensures true
{
if(tok_len(tokens,a)!=tok_len(tokens,b)){return false}
let astart=tok_start(tokens,a)
let bstart=tok_start(tokens,b)
var k=0
while(k<tok_len(tokens,a))
{
if(bufferPeek(source,astart+k)!=bufferPeek(source,bstart+k)){return false}
k=k+1
}
return true
}
fn factor(source:&owned buffer,tokens:&owned buffer,tp:&mut int,limit:int,starts:&owned buffer,lens:&owned buffer,defined:&owned buffer,values:&owned buffer,error:&mut int)->int
ensures true
{
if(*error!=0){return 0}
if(*tp>=limit){*error=1
return 0}
let kind=tok_kind(tokens,*tp)
if(kind==2){let v=tok_value(tokens,*tp)
*tp=*tp+1
return v}
if(kind==1)
{
if(word(source,tokens,*tp,116,114,117,101,0,0,4)){*tp=*tp+1
return 1}
if(word(source,tokens,*tp,102,97,108,115,101,0,5)){*tp=*tp+1
return 0}
if(*tp+1<limit && tok_kind(tokens,*tp+1)==4 && tok_value(tokens,*tp+1)==40)
{
let name_index=*tp
*tp=*tp+2
var arguments=buffer(32)
var argc=0
if(!(*tp<limit && tok_kind(tokens,*tp)==4 && tok_value(tokens,*tp)==41))
{
var more=1
while(*error==0 && more!=0)
{
let argument=boolean(source,tokens,&mut *tp,limit,starts,lens,defined,values,&mut *error)
if(*error!=0){return 0}
write32(&mut arguments,argc*4,argument)
argc=argc+1
if(*tp<limit && tok_kind(tokens,*tp)==4 && tok_value(tokens,*tp)==44){*tp=*tp+1}
else{more=0}
}
}
if(*tp>=limit || tok_kind(tokens,*tp)!=4 || tok_value(tokens,*tp)!=41){*error=1
return 0}
*tp=*tp+1
return call_function(source,tokens,name_index,&arguments,argc,limit,&mut *error)
}
let slot=lookup(source,tokens,*tp,starts,lens,defined)
*tp=*tp+1
if(slot<0){*error=1
return 0}
return read32(values,slot*4)
}
if(kind==4 && tok_value(tokens,*tp)==40)
{
*tp=*tp+1
let inner=boolean(source,tokens,&mut *tp,limit,&*starts,&*lens,&*defined,&*values,&mut *error)
if(*error!=0){return 0}
if(*tp>=limit || tok_kind(tokens,*tp)!=4 || tok_value(tokens,*tp)!=41){*error=1
return 0}
*tp=*tp+1
return inner
}
if(kind==4 && tok_value(tokens,*tp)==33)
{
*tp=*tp+1
let negated=factor(source,tokens,&mut *tp,limit,starts,lens,defined,values,&mut *error)
if(*error!=0){return 0}
if(negated==0){return 1}
return 0
}
if(kind==4 && tok_value(tokens,*tp)==45)
{
*tp=*tp+1
return 0-factor(source,tokens,&mut *tp,limit,&*starts,&*lens,&*defined,&*values,&mut *error)
}
*error=1
return 0
}
fn term(source:&owned buffer,tokens:&owned buffer,tp:&mut int,limit:int,starts:&owned buffer,lens:&owned buffer,defined:&owned buffer,values:&owned buffer,error:&mut int)->int
ensures true
{
var value=factor(source,tokens,&mut *tp,limit,&*starts,&*lens,&*defined,&*values,&mut *error)
while(*error==0 && *tp<limit && tok_kind(tokens,*tp)==4 && (tok_value(tokens,*tp)==42 || tok_value(tokens,*tp)==47 || tok_value(tokens,*tp)==37))
{
let op=tok_value(tokens,*tp)
*tp=*tp+1
let right=factor(source,tokens,&mut *tp,limit,&*starts,&*lens,&*defined,&*values,&mut *error)
if(*error!=0){return 0}
if(op==42){value=value*right}
else
{
if(op==47)
{
if(right==0){*error=1
return 0}
value=value/right
}
else
{
if(right==0){*error=1
return 0}
value=value%right
}
}
}
return value
}
fn expr(source:&owned buffer,tokens:&owned buffer,tp:&mut int,limit:int,starts:&owned buffer,lens:&owned buffer,defined:&owned buffer,values:&owned buffer,error:&mut int)->int
ensures true
{
var value=term(source,tokens,&mut *tp,limit,&*starts,&*lens,&*defined,&*values,&mut *error)
while(*error==0 && *tp<limit && tok_kind(tokens,*tp)==4 && (tok_value(tokens,*tp)==43 || tok_value(tokens,*tp)==45))
{
let op=tok_value(tokens,*tp)
*tp=*tp+1
let right=term(source,tokens,&mut *tp,limit,&*starts,&*lens,&*defined,&*values,&mut *error)
if(*error!=0){return 0}
if(op==43){value=value+right}else{value=value-right}
}
return value
}
fn skip_block(tokens:&owned buffer,tp:&mut int,limit:int,error:&mut int)->int
ensures true
{
var depth=0
while(*error==0 && *tp<limit)
{
if(tok_kind(tokens,*tp)==4 && tok_value(tokens,*tp)==123)
{
depth=depth+1
}
else
{
if(tok_kind(tokens,*tp)==4 && tok_value(tokens,*tp)==125)
{
if(depth==0)
{
*tp=*tp+1
return 0
}
depth=depth-1
}
}
*tp=*tp+1
}
*error=1
return 0
}
fn compare(source:&owned buffer,tokens:&owned buffer,tp:&mut int,limit:int,starts:&owned buffer,lens:&owned buffer,defined:&owned buffer,values:&owned buffer,error:&mut int)->int
ensures true
{
let left=expr(source,tokens,&mut *tp,limit,starts,lens,defined,values,&mut *error)
if(*error!=0){return 0}
if(*tp<limit && tok_kind(tokens,*tp)==4)
{
let op=tok_value(tokens,*tp)
if(op==62 || op==60)
{
*tp=*tp+1
var equal=0
if(*tp<limit && tok_kind(tokens,*tp)==4 && tok_value(tokens,*tp)==61){equal=1
*tp=*tp+1}
let right=expr(source,tokens,&mut *tp,limit,starts,lens,defined,values,&mut *error)
if(*error!=0){return 0}
if(op==62)
{
if(equal!=0){if(left>=right){return 1}else{return 0}}
if(left>right){return 1}else{return 0}
}
if(equal!=0){if(left<=right){return 1}else{return 0}}
if(left<right){return 1}else{return 0}
}
if(op==61 && *tp+1<limit && tok_kind(tokens,*tp+1)==4 && tok_value(tokens,*tp+1)==61)
{
*tp=*tp+2
let right=expr(source,tokens,&mut *tp,limit,starts,lens,defined,values,&mut *error)
if(*error!=0){return 0}
if(left==right){return 1}else{return 0}
}
if(op==33 && *tp+1<limit && tok_kind(tokens,*tp+1)==4 && tok_value(tokens,*tp+1)==61)
{
*tp=*tp+2
let right=expr(source,tokens,&mut *tp,limit,starts,lens,defined,values,&mut *error)
if(*error!=0){return 0}
if(left!=right){return 1}else{return 0}
}
}
return left
}
fn boolean(source:&owned buffer,tokens:&owned buffer,tp:&mut int,limit:int,starts:&owned buffer,lens:&owned buffer,defined:&owned buffer,values:&owned buffer,error:&mut int)->int
ensures true
{
var left=compare(source,tokens,&mut *tp,limit,starts,lens,defined,values,&mut *error)
while(*error==0 && *tp+1<limit && tok_kind(tokens,*tp)==4 && tok_kind(tokens,*tp+1)==4)
{
let op=tok_value(tokens,*tp)
if(op==38 && tok_value(tokens,*tp+1)==38)
{
*tp=*tp+2
let right=compare(source,tokens,&mut *tp,limit,starts,lens,defined,values,&mut *error)
if(*error!=0){return 0}
if(left!=0 && right!=0){left=1}else{left=0}
}
else
{
if(op==124 && tok_value(tokens,*tp+1)==124)
{
*tp=*tp+2
let right=compare(source,tokens,&mut *tp,limit,starts,lens,defined,values,&mut *error)
if(*error!=0){return 0}
if(left!=0 || right!=0){left=1}else{left=0}
}
else{return left}
}
}
return left
}
fn exec_block(source:&owned buffer,tokens:&owned buffer,tp:&mut int,limit:int,starts:&mut owned buffer,lens:&mut owned buffer,defined:&mut owned buffer,values:&mut owned buffer,error:&mut int,returned:&mut int,return_value:&mut int)->int
ensures true
{
while(*error==0 && *returned==0 && *tp<limit && !(tok_kind(tokens,*tp)==4 && tok_value(tokens,*tp)==125))
{
if(word(source,tokens,*tp,105,102,0,0,0,0,2))
{
*tp=*tp+1
if(*tp>=limit || tok_kind(tokens,*tp)!=4 || tok_value(tokens,*tp)!=40){*error=1
return 0}
let condition_start=*tp+1
*tp=condition_start
let condition=boolean(source,tokens,&mut *tp,limit,&*starts,&*lens,&*defined,&*values,&mut *error)
if(*error!=0){return 0}
if(*tp>=limit || tok_kind(tokens,*tp)!=4 || tok_value(tokens,*tp)!=41){*error=1
return 0}
*tp=*tp+1
if(*tp>=limit || tok_kind(tokens,*tp)!=4 || tok_value(tokens,*tp)!=123){*error=1
return 0}
*tp=*tp+1
if(condition!=0)
{
exec_block(source,tokens,&mut *tp,limit,&mut *starts,&mut *lens,&mut *defined,&mut *values,&mut *error,&mut *returned,&mut *return_value)
}
else
{
skip_block(tokens,&mut *tp,limit,&mut *error)
}
if(*error!=0){return 0}
if(word(source,tokens,*tp,101,108,115,101,0,0,4))
{
*tp=*tp+1
if(*tp>=limit || tok_kind(tokens,*tp)!=4 || tok_value(tokens,*tp)!=123){*error=1
return 0}
*tp=*tp+1
if(condition==0 && *returned==0)
{
exec_block(source,tokens,&mut *tp,limit,&mut *starts,&mut *lens,&mut *defined,&mut *values,&mut *error,&mut *returned,&mut *return_value)
}
else
{
skip_block(tokens,&mut *tp,limit,&mut *error)
}
}
}
else
{
if(word(source,tokens,*tp,119,104,105,108,101,0,5))
{
*tp=*tp+1
if(*tp>=limit || tok_kind(tokens,*tp)!=4 || tok_value(tokens,*tp)!=40){*error=1
return 0}
let condition_start=*tp+1
var body_start=condition_start
var condition=0
var body_end=body_start
var iteration=0
while(*error==0 && *returned==0)
{
*tp=condition_start
condition=boolean(source,tokens,&mut *tp,limit,&*starts,&*lens,&*defined,&*values,&mut *error)
if(*error!=0){return 0}
if(*tp>=limit || tok_kind(tokens,*tp)!=4 || tok_value(tokens,*tp)!=41){*error=1
return 0}
*tp=*tp+1
if(*tp>=limit || tok_kind(tokens,*tp)!=4 || tok_value(tokens,*tp)!=123){*error=1
return 0}
*tp=*tp+1
body_start=*tp
if(condition==0)
{
skip_block(tokens,&mut *tp,limit,&mut *error)
body_end=*tp
break
}
exec_block(source,tokens,&mut *tp,limit,&mut *starts,&mut *lens,&mut *defined,&mut *values,&mut *error,&mut *returned,&mut *return_value)
body_end=*tp
iteration=iteration+1
if(iteration>100000){*error=1}
}
*tp=body_end
}
else
{
if(word(source,tokens,*tp,114,101,116,117,114,110,6))
{
*tp=*tp+1
*return_value=boolean(source,tokens,&mut *tp,limit,&*starts,&*lens,&*defined,&*values,&mut *error)
if(*error!=0){return 0}
*returned=1
}
else
{
if(tok_kind(tokens,*tp)==4 && tok_value(tokens,*tp)==123)
{
*tp=*tp+1
exec_block(source,tokens,&mut *tp,limit,&mut *starts,&mut *lens,&mut *defined,&mut *values,&mut *error,&mut *returned,&mut *return_value)
}
else
{
if(word(source,tokens,*tp,108,101,116,0,0,0,3) || word(source,tokens,*tp,118,97,114,0,0,0,3))
{
*tp=*tp+1
if(*tp>=limit || tok_kind(tokens,*tp)!=1){*error=1
return 0}
let name_index=*tp
let name_start=tok_start(tokens,name_index)
let name_len=tok_len(tokens,name_index)
*tp=*tp+1
if(*tp>=limit || tok_kind(tokens,*tp)!=4 || tok_value(tokens,*tp)!=58){*error=1
return 0}
*tp=*tp+1
if(*tp>=limit || tok_kind(tokens,*tp)!=1){*error=1
return 0}
*tp=*tp+1
if(*tp>=limit || tok_kind(tokens,*tp)!=4 || tok_value(tokens,*tp)!=61){*error=1
return 0}
*tp=*tp+1
let value=boolean(source,tokens,&mut *tp,limit,&*starts,&*lens,&*defined,&*values,&mut *error)
if(*error!=0){return 0}
if(lookup(source,tokens,name_index,&*starts,&*lens,&*defined)>=0){*error=1
return 0}
let slot=free_slot(&*defined)
if(slot<0){*error=1
return 0}
bufferWrite(&mut *defined,slot,1)
write32(&mut *starts,slot*4,name_start)
write32(&mut *lens,slot*4,name_len)
write32(&mut *values,slot*4,value)
}
else
{
if(tok_kind(tokens,*tp)!=1){*error=1
return 0}
let name_index=*tp
*tp=*tp+1
if(*tp>=limit || tok_kind(tokens,*tp)!=4 || tok_value(tokens,*tp)!=61){*error=1
return 0}
*tp=*tp+1
let value=boolean(source,tokens,&mut *tp,limit,&*starts,&*lens,&*defined,&*values,&mut *error)
if(*error!=0){return 0}
let slot=lookup(source,tokens,name_index,&*starts,&*lens,&*defined)
if(slot<0){*error=1
return 0}
write32(&mut *values,slot*4,value)
}
}
}
}
}
}
var depth=0
while(*error==0 && *tp<limit)
{
if(tok_kind(tokens,*tp)==4 && tok_value(tokens,*tp)==123){depth=depth+1}
else
{
if(tok_kind(tokens,*tp)==4 && tok_value(tokens,*tp)==125)
{
if(depth==0){break}
depth=depth-1
}
}
*tp=*tp+1
}
if(*tp>=limit || tok_kind(tokens,*tp)!=4 || tok_value(tokens,*tp)!=125){*error=1
return 0}
*tp=*tp+1
return 0
}
fn call_function(source:&owned buffer,tokens:&owned buffer,name_index:int,arguments:&owned buffer,argc:int,limit:int,error:&mut int)->int
ensures true
{
var cursor=4
var found=0
var answer=0
while(*error==0 && cursor<limit && found==0)
{
if(!word(source,tokens,cursor,102,110,0,0,0,0,2)){*error=1
return 0}
cursor=cursor+1
let candidate=cursor
cursor=cursor+1
if(cursor>=limit || tok_kind(tokens,cursor)!=4 || tok_value(tokens,cursor)!=40){*error=1
return 0}
cursor=cursor+1
var pstarts=buffer(32)
var plens=buffer(32)
var pcount=0
while(*error==0 && cursor<limit && !(tok_kind(tokens,cursor)==4 && tok_value(tokens,cursor)==41))
{
if(tok_kind(tokens,cursor)!=1){*error=1
return 0}
write32(&mut pstarts,pcount*4,tok_start(tokens,cursor))
write32(&mut plens,pcount*4,tok_len(tokens,cursor))
pcount=pcount+1
cursor=cursor+1
if(cursor>=limit || tok_kind(tokens,cursor)!=4 || tok_value(tokens,cursor)!=58){*error=1
return 0}
cursor=cursor+1
if(cursor>=limit || tok_kind(tokens,cursor)!=1){*error=1
return 0}
cursor=cursor+1
if(cursor<limit && tok_kind(tokens,cursor)==4 && tok_value(tokens,cursor)==44){cursor=cursor+1}
}
if(cursor>=limit){*error=1
return 0}
cursor=cursor+1
if(cursor>=limit || tok_kind(tokens,cursor)!=4 || tok_value(tokens,cursor)!=45){*error=1
return 0}
cursor=cursor+1
if(cursor>=limit || tok_kind(tokens,cursor)!=4 || tok_value(tokens,cursor)!=62){*error=1
return 0}
cursor=cursor+1
if(cursor>=limit || tok_kind(tokens,cursor)!=1){*error=1
return 0}
cursor=cursor+1
if(!word(source,tokens,cursor,101,110,115,117,114,101,7)){*error=1
return 0}
cursor=cursor+1
if(!word(source,tokens,cursor,116,114,117,101,0,0,4)){*error=1
return 0}
cursor=cursor+1
if(cursor>=limit || tok_kind(tokens,cursor)!=4 || tok_value(tokens,cursor)!=123){*error=1
return 0}
cursor=cursor+1
if(tokens_text_equal(source,tokens,candidate,name_index))
{
if(pcount!=argc){*error=1
return 0}
var cstarts=buffer(128)
var clens=buffer(128)
var cdefined=buffer(32)
var cvalues=buffer(128)
var i=0
while(i<pcount)
{
let slot=free_slot(&cdefined)
if(slot<0){*error=1
return 0}
bufferWrite(&mut cdefined,slot,1)
write32(&mut cstarts,slot*4,read32(&pstarts,i*4))
write32(&mut clens,slot*4,read32(&plens,i*4))
write32(&mut cvalues,slot*4,read32(arguments,i*4))
i=i+1
}
var ctp=cursor
var cerror=0
var creturned=0
var creturn=0
exec_block(source,tokens,&mut ctp,limit,&mut cstarts,&mut clens,&mut cdefined,&mut cvalues,&mut cerror,&mut creturned,&mut creturn)
if(cerror!=0 || creturned==0){*error=1
return 0}
answer=creturn
found=1
}
else
{
skip_block(tokens,&mut cursor,limit,&mut *error)
}
}
if(found==0){*error=1
return 0}
return answer
}
fn run_program(source:&owned buffer,tokens:&owned buffer,limit:int,error:&mut int)->int
ensures true
{
var cursor=4
var found=0
var result=0
while(*error==0 && cursor<limit && found==0)
{
if(!word(source,tokens,cursor,102,110,0,0,0,0,2)){*error=1
return 0}
cursor=cursor+1
let candidate=cursor
cursor=cursor+1
if(cursor>=limit || tok_kind(tokens,cursor)!=4 || tok_value(tokens,cursor)!=40){*error=1
return 0}
cursor=cursor+1
var pcount=0
while(*error==0 && cursor<limit && !(tok_kind(tokens,cursor)==4 && tok_value(tokens,cursor)==41))
{
if(tok_kind(tokens,cursor)!=1){*error=1
return 0}
cursor=cursor+1
if(cursor>=limit || tok_kind(tokens,cursor)!=4 || tok_value(tokens,cursor)!=58){*error=1
return 0}
cursor=cursor+1
if(cursor>=limit || tok_kind(tokens,cursor)!=1){*error=1
return 0}
cursor=cursor+1
pcount=pcount+1
if(cursor<limit && tok_kind(tokens,cursor)==4 && tok_value(tokens,cursor)==44){cursor=cursor+1}
}
if(cursor>=limit){*error=1
return 0}
cursor=cursor+1
if(cursor>=limit || tok_kind(tokens,cursor)!=4 || tok_value(tokens,cursor)!=45){*error=1
return 0}
cursor=cursor+1
if(cursor>=limit || tok_kind(tokens,cursor)!=4 || tok_value(tokens,cursor)!=62){*error=1
return 0}
cursor=cursor+1
if(cursor>=limit || tok_kind(tokens,cursor)!=1){*error=1
return 0}
cursor=cursor+1
if(!word(source,tokens,cursor,101,110,115,117,114,101,7)){*error=1
return 0}
cursor=cursor+1
if(!word(source,tokens,cursor,116,114,117,101,0,0,4)){*error=1
return 0}
cursor=cursor+1
if(cursor>=limit || tok_kind(tokens,cursor)!=4 || tok_value(tokens,cursor)!=123){*error=1
return 0}
cursor=cursor+1
if(word(source,tokens,candidate,109,97,105,110,0,0,4))
{
if(pcount!=0){*error=1
return 0}
var starts=buffer(128)
var lens=buffer(128)
var defined=buffer(32)
var values=buffer(128)
var ctp=cursor
var cerror=0
var creturned=0
var creturn=0
exec_block(source,tokens,&mut ctp,limit,&mut starts,&mut lens,&mut defined,&mut values,&mut cerror,&mut creturned,&mut creturn)
if(cerror!=0 || creturned==0){*error=1
return 0}
result=creturn
cursor=ctp
found=1
}
else
{
skip_block(tokens,&mut cursor,limit,&mut *error)
}
}
if(found==0){*error=1
return 0}
while(*error==0 && cursor<limit)
{
if(!word(source,tokens,cursor,102,110,0,0,0,0,2)){*error=1
return 0}
cursor=cursor+1
if(cursor>=limit || tok_kind(tokens,cursor)!=1){*error=1
return 0}
cursor=cursor+1
if(cursor>=limit || tok_kind(tokens,cursor)!=4 || tok_value(tokens,cursor)!=40){*error=1
return 0}
cursor=cursor+1
while(*error==0 && cursor<limit && !(tok_kind(tokens,cursor)==4 && tok_value(tokens,cursor)==41))
{
if(tok_kind(tokens,cursor)!=1){*error=1
return 0}
cursor=cursor+1
if(cursor>=limit || tok_kind(tokens,cursor)!=4 || tok_value(tokens,cursor)!=58){*error=1
return 0}
cursor=cursor+1
if(cursor>=limit || tok_kind(tokens,cursor)!=1){*error=1
return 0}
cursor=cursor+1
if(cursor<limit && tok_kind(tokens,cursor)==4 && tok_value(tokens,cursor)==44){cursor=cursor+1}
}
if(cursor>=limit){*error=1
return 0}
cursor=cursor+1
if(cursor>=limit || tok_kind(tokens,cursor)!=4 || tok_value(tokens,cursor)!=45){*error=1
