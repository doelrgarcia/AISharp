cursor=cursor+1
if(!word(source,tokens,cursor,101,110,115,117,114,101,7)){*error=1
return 0}
cursor=cursor+1
if(!word(source,tokens,cursor,116,114,117,101,0,0,4)){*error=1
return 0}
cursor=cursor+1
if(cursor>=limit || tok_kind(tokens,cursor)!=4 || tok_value(tokens,cursor)!=123){*error=1
return 0}
cursor=cursor+1
skip_block(tokens,&mut cursor,limit,&mut *error)
}
return result
}
fn main()->int
ensures true
{
let source=fileRead(args[0])
let tokens=fileRead(args[1])
let limit=bufferSize(&tokens)/16-1
var error=0
let return_value=run_program(&source,&tokens,limit,&mut error)
if(error!=0){return 1}
let prefix=stringBytes("int main(void){return ")
let digits=intText(return_value)
let suffix=stringBytes(";}")
var out=buffer(bufferSize(&prefix)+bufferSize(&digits)+bufferSize(&suffix))
var pos=0
var j=0
while(j<bufferSize(&prefix)){bufferWrite(&mut out,pos,bufferPeek(&prefix,j))
pos=pos+1
j=j+1}
j=0
while(j<bufferSize(&digits)){bufferWrite(&mut out,pos,bufferPeek(&digits,j))
pos=pos+1
j=j+1}
j=0
while(j<bufferSize(&suffix)){bufferWrite(&mut out,pos,bufferPeek(&suffix,j))
pos=pos+1
j=j+1}
var exact=buffer(pos)
j=0
while(j<pos){bufferWrite(&mut exact,j,bufferPeek(&out,j))
j=j+1}
fileWrite(args[2],exact)
return 0
}
