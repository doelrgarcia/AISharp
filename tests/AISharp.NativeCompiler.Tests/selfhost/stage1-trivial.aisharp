module Stage1
intent "stage1-trivial"
fn main()->int
ensures true
{
let source=fileRead(args[0])
let prefix=stringBytes("int main(void){return ")
let suffix=stringBytes(";}")
var value=0
var seen=0
var i=0
while(i<bufferSize(&source))
{
let c=bufferPeek(&source,i)
if(seen==0)
{
if(c==114)
{
seen=1
}
}
else
{
if(c>=48 && c<=57)
{
value=value*10+(c-48)
}
else
{
if(value>0)
{
i=bufferSize(&source)
}
}
}
i=i+1
}
let digits=intText(value)
var out=buffer(256)
var pos=0
var j=0
while(j<bufferSize(&prefix))
{
bufferWrite(&mut out,pos,bufferPeek(&prefix,j))
pos=pos+1
j=j+1
}
j=0
while(j<bufferSize(&digits))
{
bufferWrite(&mut out,pos,bufferPeek(&digits,j))
pos=pos+1
j=j+1
}
j=0
while(j<bufferSize(&suffix))
{
bufferWrite(&mut out,pos,bufferPeek(&suffix,j))
pos=pos+1
j=j+1
}
var exact=buffer(pos)
var k=0
while(k<pos)
{
bufferWrite(&mut exact,k,bufferPeek(&out,k))
k=k+1
}
fileWrite(args[1],exact)
return 0
}


